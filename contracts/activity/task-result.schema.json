{
  "$defs": {
    "AttemptReference": {
      "additionalProperties": false,
      "description": "An attempt-scoped object, which names the attempt that wrote it.",
      "properties": {
        "kind": {
          "enum": [
            "result",
            "output",
            "log-tail",
            "summary",
            "checkpoint"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^/]+$",
          "title": "Name",
          "type": "string"
        },
        "producer": {
          "$ref": "#/$defs/ProducerRef"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size": {
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        },
        "uri": {
          "pattern": "^s3://wdf-(sources|components|results|checkpoints)/.+$",
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "sha256",
        "size",
        "name",
        "kind",
        "producer"
      ],
      "title": "AttemptReference",
      "type": "object"
    },
    "ContentReference": {
      "additionalProperties": false,
      "description": "A content-addressed object, which has no producer.",
      "properties": {
        "kind": {
          "enum": [
            "manifest",
            "source",
            "index",
            "component",
            "build-info"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^/]+$",
          "title": "Name",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size": {
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        },
        "uri": {
          "pattern": "^s3://wdf-(sources|components|results|checkpoints)/.+$",
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "sha256",
        "size",
        "name",
        "kind"
      ],
      "title": "ContentReference",
      "type": "object"
    },
    "LogTailReference": {
      "additionalProperties": false,
      "description": "The reference of an attempt's log tail, narrowed as ResultReference narrows its kinds.",
      "properties": {
        "kind": {
          "const": "log-tail",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^/]+$",
          "title": "Name",
          "type": "string"
        },
        "producer": {
          "$ref": "#/$defs/ProducerRef"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size": {
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        },
        "uri": {
          "pattern": "^s3://wdf-(sources|components|results|checkpoints)/.+$",
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "sha256",
        "size",
        "name",
        "kind",
        "producer"
      ],
      "title": "LogTailReference",
      "type": "object"
    },
    "ProducerRef": {
      "additionalProperties": false,
      "properties": {
        "attempt": {
          "pattern": "^r[0-9]+a[0-9]+$",
          "title": "Attempt",
          "type": "string"
        },
        "job": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Job",
          "type": "string"
        },
        "task": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,62}$",
          "title": "Task",
          "type": "string"
        }
      },
      "required": [
        "job",
        "task",
        "attempt"
      ],
      "title": "ProducerRef",
      "type": "object"
    }
  },
  "$id": "urn:wdf:schema:activity:task-result:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The result of a successful run_task: references only, never bytes.",
  "properties": {
    "log_tail": {
      "$ref": "#/$defs/LogTailReference"
    },
    "outputs": {
      "description": "The declared outputs of one task type of staging.yaml, in order.",
      "items": {
        "discriminator": {
          "mapping": {
            "build-info": "#/$defs/ContentReference",
            "checkpoint": "#/$defs/AttemptReference",
            "component": "#/$defs/ContentReference",
            "index": "#/$defs/ContentReference",
            "log-tail": "#/$defs/AttemptReference",
            "manifest": "#/$defs/ContentReference",
            "output": "#/$defs/AttemptReference",
            "result": "#/$defs/AttemptReference",
            "source": "#/$defs/ContentReference",
            "summary": "#/$defs/AttemptReference"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/ContentReference"
          },
          {
            "$ref": "#/$defs/AttemptReference"
          }
        ]
      },
      "maxItems": 2,
      "minItems": 1,
      "title": "Outputs",
      "type": "array"
    },
    "started_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$",
      "title": "Started At",
      "type": "string"
    }
  },
  "required": [
    "outputs",
    "log_tail",
    "started_at"
  ],
  "title": "contracts/activity task-result",
  "type": "object"
}
