{
  "$id": "urn:wdf:schema:job.partial:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The tasks that did not run to completion, so a partial run is never read as complete.",
  "properties": {
    "skipped_tasks": {
      "items": {
        "type": "string"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Skipped Tasks",
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "skipped_tasks"
  ],
  "title": "job.partial 1.0",
  "type": "object"
}
