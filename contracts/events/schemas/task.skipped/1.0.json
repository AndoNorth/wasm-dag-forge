{
  "$id": "urn:wdf:schema:task.skipped:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cache_key": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Cache Key",
      "type": "string"
    },
    "reason": {
      "const": "compile-cache-hit",
      "title": "Reason",
      "type": "string"
    }
  },
  "required": [
    "reason",
    "cache_key"
  ],
  "title": "task.skipped 1.0",
  "type": "object"
}
