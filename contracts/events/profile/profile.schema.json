{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "The platform profile of CloudEvents 1.0 in structured mode with the JSON event format. A constraint names its failure code in x-reason, and a constraint without one reports bad-<attribute>.",
  "type": "object",
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "time",
    "datacontenttype",
    "dataschema",
    "subject",
    "tenant",
    "jobid",
    "priorityclass",
    "jobclass",
    "traceparent",
    "data"
  ],
  "propertyNames": {
    "pattern": "^[a-z0-9]{1,20}$",
    "x-reason": "bad-extension-name"
  },
  "additionalProperties": false,
  "x-reason": "unknown-attribute",
  "properties": {
    "specversion": {
      "const": "1.0",
      "x-reason": "bad-specversion"
    },
    "id": {
      "type": "string",
      "pattern": "^[^#]+$",
      "x-reason": "id-contains-hash"
    },
    "source": {
      "type": "string",
      "pattern": "^/wdf/[a-z][a-z0-9-]*$"
    },
    "type": {
      "type": "string",
      "allOf": [
        {
          "pattern": "\\.v[1-9][0-9]*$",
          "x-reason": "type-without-major"
        },
        {
          "pattern": "^dev\\.wdf\\.(job|task)(\\.[a-z0-9]+)+\\.v[1-9][0-9]*$"
        }
      ]
    },
    "time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "datacontenttype": {
      "const": "application/json"
    },
    "dataschema": {
      "type": "string",
      "pattern": "^urn:wdf:schema:[a-z0-9]+(\\.[a-z0-9]+)*:[0-9]+\\.[0-9]+$"
    },
    "subject": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(/[a-z0-9][a-z0-9._-]{0,62})?$"
    },
    "tenant": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "jobid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "taskid": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,62}$"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "priorityclass": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
    },
    "jobclass": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
    },
    "traceparent": {
      "type": "string",
      "pattern": "^00-(?!0{32}-)[0-9a-f]{32}-(?!0{16}-)[0-9a-f]{16}-[0-9a-f]{2}$"
    },
    "tracestate": {
      "type": "string",
      "maxLength": 512
    },
    "data": {
      "type": "object"
    }
  }
}
