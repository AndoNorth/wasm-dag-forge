  "$id": "urn:wdf:schema:plan:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Tasks in topological order, ties broken by task id.",
  "properties": {
    "max_parallel": {
      "minimum": 1,
      "title": "Max Parallel",
      "type": "integer"
    },
    "parameters": {
      "additionalProperties": {
        "enum": [
          "integer",
          "string",
          "boolean",
          "seed",
          "string-list"
        ],
        "type": "string"
      },
      "title": "Parameters",
      "type": "object"
    },
    "plan_version": {
      "const": 1,
      "title": "Plan Version",
      "type": "integer"
    },
    "profile": {
      "pattern": "^[a-z]+$",
      "title": "Profile",
      "type": "string"
    },
    "tasks": {
      "items": {
        "discriminator": {
          "mapping": {
            "aggregate": "#/$defs/AggregatePlanTask",
            "compile": "#/$defs/CompilePlanTask",
            "simulate": "#/$defs/SimulatePlanTask"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/CompilePlanTask"
          },
          {
            "$ref": "#/$defs/SimulatePlanTask"
          },
          {
            "$ref": "#/$defs/AggregatePlanTask"
          }
        ]
      },
      "title": "Tasks",
      "type": "array"
    }
  },
  "required": [
    "plan_version",
    "profile",
    "max_parallel",
    "parameters",
    "tasks"
  ],
  "title": "plan 1",
  "type": "object"
}
