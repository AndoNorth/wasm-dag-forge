    "DigestListArgs": {
      "additionalProperties": false,
      "properties": {},
      "title": "DigestListArgs",
      "type": "object"
    },
    "DigestListParams": {
      "additionalProperties": false,
      "properties": {
        "aggregation": {
          "const": "digest_list",
          "title": "Aggregation",
          "type": "string"
        },
        "args": {
          "$ref": "#/$defs/DigestListArgs"
        },
        "index": {
          "anyOf": [
            {
              "$ref": "#/$defs/IndexReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "aggregation"
      ],
      "title": "DigestListParams",
      "type": "object"
    },
    "IndexReference": {
      "additionalProperties": false,
      "description": "The content-addressed reference of an aggregate index object, the `index` kind.",
      "properties": {
        "kind": {
          "const": "index",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^/]+$",
          "title": "Name",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size": {
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        },
        "uri": {
          "pattern": "^s3://wdf-sources/sha256/[0-9a-f]{2}/[0-9a-f]{64}$",
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "sha256",
        "size",
        "name",
        "kind"
      ],
      "title": "IndexReference",
      "type": "object"
    },
    "InputRef": {
      "additionalProperties": false,
      "description": "A logical reference to a declared output of another task of the same job.",
      "properties": {
        "output": {
          "pattern": "^[a-z][a-z0-9-]{0,31}$",
          "title": "Output",
          "type": "string"
        },
        "task": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,62}$",
          "title": "Task",
          "type": "string"
        }
      },
      "required": [
        "task",
        "output"
      ],
      "title": "InputRef",
      "type": "object"
    },
    "SimulateParams": {
      "additionalProperties": false,
      "properties": {
        "args": {
          "patternProperties": {
            "^[a-z][a-z0-9_]{0,31}$": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "string"
                },
                {
                  "items": {
                    "anyOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "integer"
                      },
                      {
                        "type": "string"
                      }
                    ]
                  },
                  "type": "array"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "param": {
                      "pattern": "^[a-z][a-z0-9_]{0,31}$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "param"
                  ],
                  "title": "Placeholder",
                  "type": "object"
                }
              ]
            }
          },
          "title": "Args",
          "type": "object"
        },
        "seed": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "additionalProperties": false,
              "properties": {
                "param": {
                  "pattern": "^[a-z][a-z0-9_]{0,31}$",
                  "type": "string"
                }
              },
              "required": [
                "param"
              ],
              "title": "Placeholder",
              "type": "object"
            }
          ],
          "title": "Seed"
        },
        "workload": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Workload",
          "type": "string"
        }
      },
      "required": [
        "workload",
        "seed"
      ],
      "title": "SimulateParams",
      "type": "object"
    },
