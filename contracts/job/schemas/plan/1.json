{
  "$defs": {
    "AggregatePlanTask": {
      "additionalProperties": false,
      "properties": {
        "allow_partial": {
          "title": "Allow Partial",
          "type": "boolean"
        },
        "checkpoint": {
          "title": "Checkpoint",
          "type": "boolean"
        },
        "cpu_milli": {
          "minimum": 1,
          "title": "Cpu Milli",
          "type": "integer"
        },
        "depends_on": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9._-]{0,62}$",
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,62}$",
          "title": "Id",
          "type": "string"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/InputRef"
          },
          "title": "Inputs",
          "type": "array"
        },
        "memory_mib": {
          "minimum": 1,
          "title": "Memory Mib",
          "type": "integer"
        },
        "params": {
          "discriminator": {
            "mapping": {
              "digest_list": "#/$defs/DigestListParams",
              "summary_stats": "#/$defs/SummaryStatsParams"
            },
            "propertyName": "aggregation"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/SummaryStatsParams"
            },
            {
              "$ref": "#/$defs/DigestListParams"
            }
          ],
          "title": "Params"
        },
        "pool": {
          "const": "aggregate",
          "title": "Pool",
          "type": "string"
        },
        "retries": {
          "minimum": 0,
          "title": "Retries",
          "type": "integer"
        },
        "run_timeout_s": {
          "minimum": 1,
          "title": "Run Timeout S",
          "type": "integer"
        },
        "type": {
          "const": "aggregate",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "depends_on",
        "inputs",
        "cpu_milli",
        "memory_mib",
        "run_timeout_s",
        "retries",
        "checkpoint",
        "allow_partial",
        "type",
        "pool",
        "params"
      ],
      "title": "AggregatePlanTask",
      "type": "object"
    },
    "CompileParams": {
      "additionalProperties": false,
      "properties": {
        "entry": {
          "maxLength": 128,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$",
          "title": "Entry",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/SourceReference"
        }
      },
      "required": [
        "source",
        "entry"
      ],
      "title": "CompileParams",
      "type": "object"
    },
    "CompilePlanTask": {
      "additionalProperties": false,
      "properties": {
        "allow_partial": {
          "title": "Allow Partial",
          "type": "boolean"
        },
        "checkpoint": {
          "title": "Checkpoint",
          "type": "boolean"
        },
        "cpu_milli": {
          "minimum": 1,
