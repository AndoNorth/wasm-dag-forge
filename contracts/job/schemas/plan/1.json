          "type": "string"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/InputRef"
          },
          "title": "Inputs",
          "type": "array"
        },
        "memory_mib": {
          "minimum": 1,
          "title": "Memory Mib",
          "type": "integer"
        },
        "params": {
          "$ref": "#/$defs/CompileParams"
        },
        "pool": {
          "const": "compile",
          "title": "Pool",
          "type": "string"
        },
        "retries": {
          "minimum": 0,
          "title": "Retries",
          "type": "integer"
        },
        "run_timeout_s": {
          "minimum": 1,
          "title": "Run Timeout S",
          "type": "integer"
        },
        "type": {
          "const": "compile",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "depends_on",
        "inputs",
        "cpu_milli",
        "memory_mib",
        "run_timeout_s",
        "retries",
        "checkpoint",
        "allow_partial",
        "type",
        "pool",
        "params"
      ],
      "title": "CompilePlanTask",
