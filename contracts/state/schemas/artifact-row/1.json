{
  "$id": "urn:wdf:schema:state.artifact-row:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A reference or a compile cache entry, with the columns of contracts/state/README.md.\n\nThe producer fields have no default, because the attempt is stored as the reference carries it\nand never computed: all three are null for the content-addressed kinds and for a cache entry.",
  "properties": {
    "bucket": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Bucket"
    },
    "cache_key": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cache Key"
    },
    "componentize_py_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Componentize Py Version"
    },
    "created_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Set by the database.",
      "title": "Created At"
    },
    "deleted_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Deleted At"
    },
    "key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Key"
    },
    "kind": {
      "enum": [
        "manifest",
        "source",
        "index",
        "component",
        "build-info",
        "result",
        "output",
        "log-tail",
        "summary",
        "checkpoint",
        "compile-cache"
      ],
      "title": "Kind",
      "type": "string"
    },
    "last_used_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Used At"
    },
    "name": {
      "anyOf": [
        {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^/]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Name"
    },
    "producer_attempt": {
      "anyOf": [
        {
          "pattern": "^r[0-9]+a[0-9]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Producer Attempt"
    },
    "producer_job": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Producer Job"
    },
    "producer_task": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,62}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Producer Task"
    },
    "row_id": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Generated identity, never written.",
      "title": "Row Id"
    },
    "sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sha256"
    },
    "size": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Size"
    },
    "uri": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Uri"
    },
    "wasm_uri": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Wasm Uri"
    },
    "wit_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Wit Version"
    }
  },
  "required": [
    "kind",
    "producer_job",
    "producer_task",
    "producer_attempt"
  ],
  "title": "artifact-row 1",
  "type": "object"
}
