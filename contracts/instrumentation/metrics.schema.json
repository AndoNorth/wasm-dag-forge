{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AndoNorth/wasm-dag-forge/contracts/instrumentation/metrics.schema.json",
  "title": "contracts/instrumentation/metrics.yaml",
  "type": "object",
  "required": ["metrics"],
  "additionalProperties": false,
  "x-label-denylist": [
    "jobid",
    "job_id",
    "taskid",
    "task_id",
    "event_id",
    "eventid",
    "cloudevent_id",
    "traceid",
    "trace_id",
    "spanid",
    "span_id",
    "batch_id",
    "submission_key"
  ],
  "properties": {
    "metrics": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["type", "help", "labels"],
        "additionalProperties": false,
        "properties": {
          "type": { "enum": ["counter", "gauge", "histogram"] },
          "unit": { "enum": ["bytes", "seconds", "ratio"] },
          "help": { "type": "string", "minLength": 1 },
          "buckets": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "number" }
          },
          "labels": {
            "type": "object",
            "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$", "not": { "enum": ["le", "quantile"] } },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "values": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string" }
                },
                "values_from": { "type": "string", "pattern": "^[a-zA-Z0-9._/-]+$" }
              }
            }
          }
        }
      }
    }
  }
}
