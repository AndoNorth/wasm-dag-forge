{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A pointer to an object in a bucket. It never holds bytes, and the consumer verifies sha256 and size against the object.",
  "else": {
    "not": {
      "required": [
        "producer"
      ]
    }
  },
  "if": {
    "properties": {
      "kind": {
        "enum": [
          "result",
          "output",
          "log-tail",
          "summary",
          "checkpoint"
        ]
      }
    },
    "required": [
      "kind"
    ]
  },
  "properties": {
    "kind": {
      "enum": [
        "manifest",
        "source",
        "index",
        "component",
        "build-info",
        "result",
        "output",
        "log-tail",
        "summary",
        "checkpoint"
      ]
    },
    "name": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[^/]+$",
      "type": "string"
    },
    "producer": {
      "additionalProperties": false,
      "description": "The attempt that wrote the object, present for the attempt-scoped kinds only.",
      "properties": {
        "attempt": {
          "description": "An attempt identity as the key formulas define it.",
          "pattern": "^r[0-9]+a[0-9]+$",
          "type": "string"
        },
        "job": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        },
        "task": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,62}$",
          "type": "string"
        }
      },
      "required": [
        "job",
        "task",
        "attempt"
      ],
      "type": "object"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "size": {
      "minimum": 0,
      "type": "integer"
    },
    "uri": {
      "pattern": "^s3://wdf-(sources|components|results|checkpoints)/.+$",
      "type": "string"
    }
  },
  "required": [
    "uri",
    "sha256",
    "size",
    "name",
    "kind"
  ],
  "then": {
    "required": [
      "producer"
    ]
  },
  "title": "Artifact reference",
  "type": "object"
}
