0;" vertex="1" parent="1"><mxGeometry x="330" y="240" width="200" height="18" as="geometry"/></mxCell><mxCell id="lp1" value="poll, heartbeat, cancel" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="330" y="340" width="200" height="18" as="geometry"/></mxCell><mxCell id="lp2" value="poll, heartbeat, cancel" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="330" y="440" width="200" height="18" as="geometry"/></mxCell><mxCell id="l6" value="any pool, reported as failure" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="460" y="520" width="130" height="18" as="geometry"/></mxCell><mxCell id="l7" value="retry or pause job" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="170" y="556" width="130" height="18" as="geometry"/></mxCell><mxCell id="l8" value="checkpoint write" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="800" y="530" width="125" height="18" as="geometry"/></mxCell><mxCell id="legend-h" value="Legend" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Mono;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="640" width="60" height="18" as="geometry"/></mxCell><mxCell id="lg0s" value="" style="rounded=1;arcSize=30;html=1;fillColor=none;strokeColor=#2fd4bf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="88" y="644" width="10" height="10" as="geometry"/></mxCell><mxCell id="lg0t" value="Temporal and placement" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="103" y="640" width="140" height="18" as="geometry"/></mxCell><mxCell id="lg1s" value="" style="rounded=1;arcSize=30;html=1;fillColor=none;strokeColor=#f4bf51;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="257" y="644" width="10" height="10" as="geometry"/></mxCell><mxCell id="lg1t" value="durable state" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="272" y="640" width="80" height="18" as="geometry"/></mxCell><mxCell id="lg2s" value="" style="rounded=1;arcSize=30;html=1;fillColor=none;strokeColor=#fb7085;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="366" y="644" width="10" height="10" as="geometry"/></mxCell><mxCell id="lg2t" value="failure path" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="381" y="640" width="76" height="18" as="geometry"/></mxCell><mxCell id="lg3s" value="" style="rounded=1;arcSize=30;html=1;fillColor=none;strokeColor=#8c8f98;strokeWidth=1.5;dashed=1;dashPattern=3 2;" vertex="1" parent="1"><mxGeometry x="471" y="644" width="10" height="10" as="geometry"/></mxCell><mxCell id="lg3t" value="planned or optional" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="486" y="640" width="116" height="18" as="geometry"/></mxCell><mxCell id="caption" value="Temporal owns the workflow and the task backlog. For each task the scheduler reads pool capacity (node allocatable minus pod requests) and answers with a task queue and priority class, nothing more. Each pool has its own Temporal task queue served by long-lived slot worker pods, each carrying a worker build id for versioned workflow code. Pods heartbeat with a checkpoint reference, and cancel arrives on the heartbeat reply. Checkpoints go to object storage so a task can resume. An OOM kill shows as exit code 137 plus a node event and counts as a task failure." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="670" width="920" height="56" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>