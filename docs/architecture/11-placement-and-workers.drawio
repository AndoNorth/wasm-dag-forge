<mxfile host="app.diagrams.net"><diagram id="Placement and workers" name="Placement and workers"><mxGraphModel dx="960" dy="760" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="960" pageHeight="760" background="#0a1120" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Placement and workers" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#c9cbd0;fontSize=20;fontStyle=1;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="920" height="32" as="geometry"/></mxCell><mxCell id="tmp" value="" style="rounded=1;arcSize=5;html=1;whiteSpace=wrap;fillColor=#152940;strokeColor=#2fd4bf;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="250" height="444" as="geometry"/></mxCell><mxCell id="tmpl" value="TEMPORAL" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Mono;spacing=0;" vertex="1" parent="1"><mxGeometry x="42" y="78" width="226" height="18" as="geometry"/></mxCell><mxCell id="wf" value='Workflow&lt;br&gt;&lt;font color="#8c8f98" style="font-size:11px"&gt;dependencies, retries, timeouts&lt;/font&gt;' style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="45" y="100" width="220" height="56" as="geometry"/></mxCell><mxCell id="bl" value="" style="rounded=1;arcSize=5;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="45" y="196" width="220" height="304" as="geometry"/></mxCell><mxCell id="bll" value="TASK BACKLOG" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Mono;spacing=0;" vertex="1" parent="1"><mxGeometry x="57" y="204" width="196" height="18" as="geometry"/></mxCell><mxCell id="tq0" value='compile task queue&lt;br&gt;&lt;font color="#8c8f98" style="font-size:10px"&gt;backlog by priority class&lt;/font&gt;' style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="60" y="236" width="190" height="52" as="geometry"/></mxCell><mxCell id="tq1" value='simulate task queue&lt;br&gt;&lt;font color="#8c8f98" style="font-size:10px"&gt;backlog by priority class&lt;/font&gt;' style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="60" y="336" width="190" height="52" as="geometry"/></mxCell><mxCell id="tq2" value='aggregate task queue&lt;br&gt;&lt;font color="#8c8f98" style="font-size:10px"&gt;backlog by priority class&lt;/font&gt;' style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="60" y="436" width="190" height="52" as="geometry"/></mxCell><mxCell id="sch" value='Scheduler&lt;br&gt;&lt;font color="#8c8f98" style="font-size:10px"&gt;picks task queue and priority class&lt;br&gt;never holds a backlog&lt;br&gt;capacity: allocatable minus requests&lt;/font&gt;' style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#152940;strokeColor=#2fd4bf;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="340" y="76" width="200" height="92" as="geometry"/></mxCell><mxCell id="k8s" value='Kubernetes API&lt;br&gt;&lt;font color="#8c8f98" style="font-size:10px"&gt;node allocatable, pod requests, pod status, node events&lt;/font&gt;' style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="640" y="76" width="275" height="64" as="geometry"/></mxCell><mxCell id="pool0" value="" style="rounded=1;arcSize=5;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="555" y="210" width="360" height="88" as="geometry"/></mxCell><mxCell id="pool0l" value="COMPILE POOL  wdf.dev/pool=compile" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Mono;spacing=0;" vertex="1" parent="1"><mxGeometry x="567" y="218" width="336" height="18" as="geometry"/></mxCell><mxCell id="pod0" value='Slot worker pods&lt;br&gt;&lt;font color="#8c8f98" style="font-size:10px"&gt;long-lived, worker build id, heartbeat, cancel on reply&lt;/font&gt;' style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#152940;strokeColor=#2fd4bf;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="570" y="236" width="330" height="52" as="geometry"/></mxCell><mxCell id="pool1" value="" style="rounded=1;arcSize=5;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="555" y="310" width="360" height="88" as="geometry"/></mxCell><mxCell id="pool1l" value="SIMULATE POOL  wdf.dev/pool=simulate" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Mono;spacing=0;" vertex="1" parent="1"><mxGeometry x="567" y="318" width="336" height="18" as="geometry"/></mxCell><mxCell id="pod1" value='Slot worker pods&lt;br&gt;&lt;font color="#8c8f98" style="font-size:10px"&gt;long-lived, worker build id, heartbeat, cancel on reply&lt;/font&gt;' style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#152940;strokeColor=#2fd4bf;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="570" y="336" width="330" height="52" as="geometry"/></mxCell><mxCell id="pool2" value="" style="rounded=1;arcSize=5;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="555" y="410" width="360" height="88" as="geometry"/></mxCell><mxCell id="pool2l" value="AGGREGATE POOL  wdf.dev/pool=aggregate" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Mono;spacing=0;" vertex="1" parent="1"><mxGeometry x="567" y="418" width="336" height="18" as="geometry"/></mxCell><mxCell id="pod2" value='Slot worker pods&lt;br&gt;&lt;font color="#8c8f98" style="font-size:10px"&gt;long-lived, worker build id, heartbeat, cancel on reply&lt;/font&gt;' style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#152940;strokeColor=#2fd4bf;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="570" y="436" width="330" height="52" as="geometry"/></mxCell><mxCell id="oom" value='OOM kill&lt;br&gt;&lt;font color="#8c8f98" style="font-size:10px"&gt;exit code 137 plus node event&lt;/font&gt;' style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#212240;strokeColor=#fb7085;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="400" y="548" width="230" height="5