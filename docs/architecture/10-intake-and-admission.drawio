mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="432" y="451"/><mxPoint x="432" y="250"/></Array></mxGeometry></mxCell><mxCell id="e33" style="endArrow=block;endFill=1;startArrow=none;startFill=1;html=1;rounded=0;strokeColor=#8c8f98;strokeWidth=1.6;dashed=1;dashPattern=5 4;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.05;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="dep" target="a3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e34" style="endArrow=block;endFill=1;startArrow=none;startFill=1;html=1;rounded=0;strokeColor=#8c8f98;strokeWidth=1.6;exitX=0.685;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="adm" target="st"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e35" style="endArrow=block;endFill=1;startArrow=none;startFill=1;html=1;rounded=0;strokeColor=#8c8f98;strokeWidth=1.6;dashed=1;dashPattern=5 4;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="q" target="met"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="535" y="76"/></Array></mxGeometry></mxCell><mxCell id="e36" style="endArrow=block;endFill=1;startArrow=none;startFill=1;html=1;rounded=0;strokeColor=#8c8f98;strokeWidth=1.6;dashed=1;dashPattern=5 4;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="adm" target="met"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l1" value="1. insert" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="160" y="166" width="60" height="18" as="geometry"/></mxCell><mxCell id="l2" value="2. publish" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="390" y="166" width="60" height="18" as="geometry"/></mxCell><mxCell id="l3" value="pull" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="622" y="170" width="76" height="18" as="geometry"/></mxCell><mxCell id="l4" value="delivery limit" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="540" y="282" width="90" height="18" as="geometry"/></mxCell><mxCell id="l5" value="reject" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="622" y="322" width="76" height="18" as="geometry"/></mxCell><mxCell id="l7" value="scan" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="328" y="235" width="90" height="18" as="geometry"/></mxCell><mxCell id="l8" value="duplicate key" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="100" y="247" width="100" height="18" as="geometry"/></mxCell><mxCell id="legend-h" value="Legend" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Mono;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="580" width="60" height="18" as="geometry"/></mxCell><mxCell id="lg0s" value="" style="rounded=1;arcSize=30;html=1;fillColor=none;strokeColor=#0ca5e9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="88" y="584" width="10" height="10" as="geometry"/></mxCell><mxCell id="lg0t" value="intake and admission" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="103" y="580" width="124" height="18" as="geometry"/></mxCell><mxCell id="lg1s" value="" style="rounded=1;arcSize=30;html=1;fillColor=none;strokeColor=#f4bf51;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="241" y="584" width="10" height="10" as="geometry"/></mxCell><mxCell id="lg1t" value="Postgres row of record" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="256" y="580" width="130" height="18" as="geometry"/></mxCell><mxCell id="lg2s" value="" style="rounded=1;arcSize=30;html=1;fillColor=none;strokeColor=#2fd4bf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="400" y="584" width="10" height="10" as="geometry"/></mxCell><mxCell id="lg2t" value="Temporal" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="415" y="580" width="56" height="18" as="geometry"/></mxCell><mxCell id="lg3s" value="" style="rounded=1;arcSize=30;html=1;fillColor=none;strokeColor=#fb7085;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="485" y="584" width="10" height="10" as="geometry"/></mxCell><mxCell id="lg3t" value="failure path" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="500" y="580" width="76" height="18" as="geometry"/></mxCell><mxCell id="lg4s" value="" style="rounded=1;arcSize=30;html=1;fillColor=none;strokeColor=#8c8f98;strokeWidth=1.5;dashed=1;dashPattern=3 2;" vertex="1" parent="1"><mxGeometry x="590" y="584" width="10" height="10" as="geometry"/></mxCell><mxCell id="lg4t" value="planned or optional" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="605" y="580" width="116" height="18" as="geometry"/></mxCell><mxCell id="caption" value="A job is accepted once, by a unique key on the accepted-jobs row, then published. The reconciler republishes only rows with no publish receipt, so a crash between insert and publish loses nothing. Each (tenant, class) has its own small queue and the controller pulls with credit, so the broker never orders across tenants. Admission starts the workflow with an id derived from (tenant, key): an id that already exists is acked and dropped. Only intake messages that cannot be processed reach the DLQ." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="610" width="920" height="56" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>