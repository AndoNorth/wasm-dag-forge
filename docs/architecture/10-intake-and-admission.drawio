<mxfile host="app.diagrams.net"><diagram id="Intake and admission" name="Intake and admission"><mxGraphModel dx="960" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="960" pageHeight="700" background="#0a1120" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Intake and admission" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#c9cbd0;fontSize=20;fontStyle=1;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="920" height="32" as="geometry"/></mxCell><mxCell id="met" value='Metrics&lt;br&gt;&lt;font color="#8c8f98" style="font-size:11px"&gt;queue and DLQ depth, admits, rejects, wait time&lt;/font&gt;' style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="700" y="48" width="230" height="56" as="geometry"/></mxCell><mxCell id="sub" value='Submit API&lt;br&gt;&lt;font color="#8c8f98" style="font-size:10px"&gt;batch of up to 100,000 jobs&lt;/font&gt;' style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="30" y="162" width="130" height="56" as="geometry"/></mxCell><mxCell id="row" value='Accepted-jobs row&lt;br&gt;&lt;font color="#8c8f98" style="font-size:10px"&gt;unique (tenant, key), publish receipt&lt;/font&gt;' style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#292541;strokeColor=#f4bf51;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="220" y="162" width="170" height="56" as="geometry"/></mxCell><mxCell id="dup" value='Return existing job&lt;br&gt;&lt;font color="#8c8f98" style="font-size:10px"&gt;key already accepted&lt;/font&gt;' style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="30" y="270" width="130" height="56" as="geometry"/></mxCell><mxCell id="rec" value='Reconciler&lt;br&gt;&lt;font color="#8c8f98" style="font-size:10px"&gt;republishes rows with no publish receipt&lt;/font&gt;' style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="220" y="270" width="170" height="56" as="geometry"/></mxCell><mxCell id="q" value="" style="rounded=1;arcSize=5;html=1;whiteSpace=wrap;fillColor=#16243e;strokeColor=#0ca5e9;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="450" y="130" width="170" height="150" as="geometry"/></mxCell><mxCell id="ql" value="INTAKE QUEUES" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Mono;spacing=0;" vertex="1" parent="1"><mxGeometry x="462" y="138" width="146" height="18" as="geometry"/></mxCell><mxCell id="q0" value="tenant-a . high" style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="462" y="164" width="146" height="28" as="geometry"/></mxCell><mxCell id="q1" value="tenant-a . low" style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="462" y="200" width="146" height="28" as="geometry"/></mxCell><mxCell id="q2" value="tenant-b . normal" style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="462" y="236" width="146" height="28" as="geometry"/></mxCell><mxCell id="adm" value="" style="rounded=1;arcSize=5;html=1;whiteSpace=wrap;fillColor=#16243e;strokeColor=#0ca5e9;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="700" y="130" width="230" height="286" as="geometry"/></mxCell><mxCell id="adml" value="ADMISSION CONTROLLER" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Mono;spacing=0;" vertex="1" parent="1"><mxGeometry x="712" y="138" width="206" height="18" as="geometry"/></mxCell><mxCell id="a0" value='Pull with credit&lt;br&gt;&lt;font color="#8c8f98" style="font-size:10px"&gt;one credit per free admission slot&lt;/font&gt;' style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="715" y="164" width="200" height="52" as="geometry"/></mxCell><mxCell id="a1" value='Strict priority order&lt;br&gt;&lt;font color="#8c8f98" style="font-size:10px"&gt;1 admission in 5 reserved for the lowest waiting class&lt;/font&gt;' style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="715" y="226" width="200" height="52" as="geometry"/></mxCell><mxCell id="a2" value='Quotas and live-job caps&lt;br&gt;&lt;font color="#8c8f98" style="font-size:10px"&gt;per tenant, and per class (short, long)&lt;/font&gt;' style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="715" y="288" width="200" height="52" as="geometry"/></mxCell><mxCell id="a3" value='Backpressure gate&lt;br&gt;&lt;font color="#8c8f98" style="font-size:10px"&gt;pause above high watermark, resume below low&lt;/font&gt;' style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="715" y="350" width="200" height="52" as="geometry"/></mxCell><mxCell id="dlq" value='Dead-letter queue&lt;br&gt;&lt;font color="#8c8f98" style="font-size:10px"&gt;MALFORMED, INVALID_DAG,&lt;br&gt;UNKNOWN_TENANT,&lt;br&gt;CANNOT_START&lt;/font&gt;' style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#212240;strokeColor=#fb7085;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="450" y="300" width="170" height="86" as="geometry"/></mxCell><mxCell id="rep" value='Replay tool&lt;br&gt;&lt;font color="#8c8f98" style="font-size:10px"&gt;republish with same key&lt;/font&gt;' style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="450" y="426" width="170" height="50" as="geometry"/></mxCell><mxCell id="tmp" value="" style="rounded=1;arcSize=5;html=1;whiteSpace=wrap;fillColor=#152940;strokeColor=#2fd4bf;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="640" y="460" width="290" height="100" as="geometry"/></mxCell><mxCell id="tmpl" value="TEMPORAL" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Mono;spacing=0;" vertex="1" parent="1"><mxGeometry x="652" y="468" width="266" height="18" as="geometry"/></mxCell><mxCell id="dep" value='Task queue depth&lt;br&gt;&lt;font color="#8c8f98" style="font-size:10px"&gt;layer 2 backlog&lt;/font&gt;' style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="665" y="488" width="120" height="56" as="geometry"/></mxCell><mxCell id="st" value='Start workflow&lt;br&gt;&lt;font color="#8c8f98" style="font-size:10px"&gt;deterministic workflow id&lt;/font&gt;' style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="800" y="488" width="115" height="56" as="geometry"/></mxCell><mxCell id="e23" style="endArrow=block;endFill=1;startArrow=none;startFill=1;html=1;rounded=0;strokeColor=#8c8f98;strokeWidth=1.6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sub" target="row"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e24" style="endArrow=block;endFill=1;startArrow=none;startFill=1;html=1;rounded=0;strokeColor=#8c8f98;strokeWidth=1.6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="row" target="q"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e25" style="endArrow=block;endFill=1;startArrow=none;startFill=1;html=1;rounded=0;strokeColor=#fb7085;strokeWidth=1.6;exitX=0.176;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="row" target="dup"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="250" y="244"/><mxPoint x="95" y="244"/></Array></mxGeometry></mxCell><mxCell id="e26" style="endArrow=block;endFill=1;startArrow=none;startFill=1;html=1;rounded=0;strokeColor=#8c8f98;strokeWidth=1.6;exitX=0.588;exitY=0;exitDx=0;exitDy=0;entryX=0.588;entryY=1;entryDx=0;entryDy=0;" edge="1" 