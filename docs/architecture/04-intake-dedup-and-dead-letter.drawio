amily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="411" y="396" width="62" height="18" as="geometry"/></mxCell><mxCell id="caption" value="Duplicates are stopped once, at submit, by a unique key on the job row. Admission treats an already-running workflow id as a harmless repeat. Only intake messages that cannot be processed reach the DLQ; a task that exhausts its retries is a job outcome, not a dead letter." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="426" width="840" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
