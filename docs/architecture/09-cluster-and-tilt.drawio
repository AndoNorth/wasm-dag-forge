;spacing=0;" vertex="1" parent="1"><mxGeometry x="409" y="980" width="80" height="18" as="geometry"/></mxCell><mxCell id="c68" style="endArrow=none;html=1;strokeColor=#8c8f98;strokeWidth=1.6;dashed=1;dashPattern=5 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="507" y="989" as="sourcePoint"/><mxPoint x="529" y="989" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c69" value="planned or optional" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="537" y="980" width="120" height="18" as="geometry"/></mxCell><mxCell id="caption" value="Docker caps each node container and the kubelet reservation makes allocatable match, so the scheduler cannot overcommit a node. CPU is a CFS quota, not core isolation. An OOM kill shows as exit code 137 and not reason OOMKilled, so detect it by exit code plus node events. Profiles: minimal is infra, dev is infra, control and workers, full adds obs, ci is dev driven by tilt ci. Presets change only the numbers." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="1010" width="840" height="56" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>