<mxfile host="app.diagrams.net"><diagram id="d9" name="Fixed-resource cluster and Tilt"><mxGraphModel dx="880" dy="1090" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="880" pageHeight="1090" background="#0a1120" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Fixed-resource cluster and Tilt" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#c9cbd0;fontSize=20;fontStyle=1;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="840" height="32" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=5;html=1;whiteSpace=wrap;fillColor=#16243e;strokeColor=#0ca5e9;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="64" width="840" height="110" as="geometry"/></mxCell><mxCell id="c4" value="Cluster build, run by just up" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="32" y="70" width="300" height="18" as="geometry"/></mxCell><mxCell id="c5" value='Preset&lt;br&gt;&lt;font color="#8c8f98" style="font-size:11px"&gt;ci, dev, soak: node count, cpus, memory. Soak host is open&lt;/font&gt;' style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fillColor=#292541;strokeColor=#f4bf51;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="32" y="100" width="144" height="62" as="geometry"/></mxCell><mxCell id="c6" value='Render&lt;br&gt;&lt;font color="#8c8f98" style="font-size:11px"&gt;kind config with per-node kubelet args&lt;/font&gt;' style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="200" y="100" width="144" height="62" as="geometry"/></mxCell><mxCell id="c7" value='ctlptl apply&lt;br&gt;&lt;font color="#8c8f98" style="font-size:11px"&gt;kind cluster and local registry&lt;/font&gt;' style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="368" y="100" width="144" height="62" as="geometry"/></mxCell><mxCell id="c8" value='Hard limits&lt;br&gt;&lt;font color="#8c8f98" style="font-size:11px"&gt;docker update cpus, memory, swap = memory&lt;/font&gt;' style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fillColor=#152940;strokeColor=#2fd4bf;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="536" y="100" width="144" height="62" as="geometry"/></mxCell><mxCell id="c9" value='cluster-verify&lt;br&gt;&lt;font color="#8c8f98" style="font-size:11px"&gt;fails if limits are not real&lt;/font&gt;' style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fillColor=#152940;strokeColor=#2fd4bf;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="704" y="100" width="144" height="62" as="geometry"/></mxCell><mxCell id="c10" style="endArrow=block;endFill=1;startArrow=none;html=1;rounded=0;strokeColor=#8c8f98;strokeWidth=1.6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" style="endArrow=block;endFill=1;startArrow=none;html=1;rounded=0;strokeColor=#8c8f98;strokeWidth=1.6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" style="endArrow=block;endFill=1;startArrow=none;html=1;rounded=0;strokeColor=#8c8f98;strokeWidth=1.6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" style="endArrow=block;endFill=1;startArrow=none;html=1;rounded=0;strokeColor=#8c8f98;strokeWidth=1.6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="" style="rounded=1;arcSize=5;html=1;whiteSpace=wrap;fillColor=#16243e;strokeColor=#0ca5e9;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="214" width="840" height="300" as="geometry"/></mxCell><mxCell id="c15" value="kind cluster wdf (kind-wdf)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="32" y="220" width="240" height="18" as="geometry"/></mxCell><mxCell id="c16" value='Canaries prove the limits are real&lt;br&gt;&lt;font color="#8c8f98" style="font-size:11px"&gt;node memory.max and cpu.max equal the preset, swap 0, allocatable = limit minus overhead. Oversized pod stays Pending. Memory hog: node stays Ready, pod exits 137. Taint repels pods without a toleration. Second just up changes nothing&lt;/font&gt;' style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fillColor=#152940;strokeColor=#2fd4bf;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="32" y="250" width="804" height="84" as="geometry"/></mxCell><mxCell id="c17" value='Reservation on every node&lt;br&gt;&lt;font color="#8c8f98" style="font-size:11px"&gt;kubelet system-reserved cpu = host cpus - node cpus, eviction-hard memory.available = host memory - node memory + overhead&lt;/font&gt;' style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fillColor=#152940;strokeColor=#2fd4bf;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="32" y="346" width="804" height="56" as="geometry"/></mxCell><mxCell id="c18" value='control plane&lt;br&gt;&lt;font color="#8c8f98" style="font-size:11px"&gt;kubeadm control plane&lt;/font&gt;' style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="32" y="414" width="152" height="84" as="geometry"/></mxCell><mxCell id="c19" value='infra node&lt;br&gt;&lt;font color="#8c8f98" style="font-size:11px"&gt;label wdf.dev/pool=infra&lt;/font&gt;' style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="196" y="414" width="152" height="84" as="geometry"/></mxCell><mxCell id="c20" value='obs node&lt;br&gt;&lt;font color="#8c8f98" style="font-size:11px"&gt;label pool=obs, idle without obs&lt;/font&gt;' style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;dashed=1;dashPattern=5 4;" vertex="1" parent="1"><mxGeometry x="360" y="414" width="152" height="84" as="geometry"/></mxCell><mxCell id="c21" value='build pool&lt;br&gt;&lt;font color="#8c8f98" style="font-size:11px"&gt;label pool=build, taint NoSchedule&lt;/font&gt;' style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fillColor=#152940;strokeColor=#2fd4bf;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="524" y="414" width="152" height="84" as="geometry"/></mxCell><mxCell id="c22" value='exec pool&lt;br&gt;&lt;font color="#8c8f98" style="font-size:11px"&gt;label pool=exec, taint NoSchedule&lt;/font&gt;' style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fillColor=#152940;strokeColor=#2fd4bf;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="688" y="414" width="152" height="84" as="geometry"/></mxCell><mxCell id="c23" style="endArrow=block;endFill=1;startArrow=none;html=1;rounded=0;strokeColor=#8c8f98;strokeWidth=1.6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" style="endArrow=block;endFill=1;startArrow=none;html=1;rounded=0;strokeColor=#8c8f98;strokeWidth=1.6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" style="endArrow=block;endFill=1;startArrow=none;html=1;rounded=0;strokeColor=#8c8f98;strokeWidth=1.6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" style="endArrow=block;endFill=1;startArrow=none;html=1;rounded=0;strokeColor=#8c8f98;strokeWidth=1.6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.9253731343283582;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="kubelet args" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="278" y="182" width="80" height="18" as="geometry"/></mxCell><mxCell id="c28" value="creates" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="446" y="182" width="50" height="18" as="geometry"/></mxCell><mxCell id="c29" value="docker update" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="614" y="182" width="90" height="18" as="geometry"/></mxCell><mxCell id="c30" value="asserts" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="782" y="182" width="60" height="18" as="geometry"/></mxCell><mxCell id="c31" value="" style="rounded=1;arcSize=5;html=1;whiteSpace=wrap;fillColor=#16243e;strokeColor=#0ca5e9;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="554" width="840" height="122" as="geometry"/></mxCell><mxCell id="c32" value="Namespaces, each with a ResourceQuota and a LimitRange" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="232" y="560" width="330" height="18" as="geometry"/></mxCell><mxCell id="c33" value='wdf-infra&lt;br&gt;&lt;font color="#8c8f98" style="font-size:11px"&gt;Temporal, Postgres, RabbitMQ, object storage&lt;/font&gt;' style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="32" y="590" width="192" height="72" as="geometry"/></mxCell><mxCell id="c34" value='wdf-control&lt;br&gt;&lt;font color="#8c8f98" style="font-size:11px"&gt;admission, placement scheduler, workflow workers&lt;/font&gt;' style="rounded=1;arcS