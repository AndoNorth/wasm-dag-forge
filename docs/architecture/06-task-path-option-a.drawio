<mxfile host="app.diagrams.net"><diagram id="d6" name="Task path (option A)"><mxGraphModel dx="880" dy="407" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="880" pageHeight="407" background="#0a1120" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Task path (option A)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#c9cbd0;fontSize=20;fontStyle=1;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="840" height="32" as="geometry"/></mxCell><mxCell id="c3" value="Workflow&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:11px&quot;&gt;Temporal, owns the job&lt;/font&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="150" height="60" as="geometry"/></mxCell><mxCell id="c4" value="Scheduler service&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:11px&quot;&gt;chooses queue and priority&lt;/font&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fillColor=#152940;strokeColor=#2fd4bf;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="270" y="90" width="190" height="60" as="geometry"/></mxCell><mxCell id="c5" value="Task queues&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:11px&quot;&gt;Temporal, one per pool&lt;/font&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="490" y="180" width="170" height="60" as="geometry"/></mxCell><mxCell id="c6" value="Workers&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:11px&quot;&gt;poll, run, heartbe