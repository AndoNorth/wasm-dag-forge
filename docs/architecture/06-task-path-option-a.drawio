nts"><mxPoint x="115" y="120"/></Array></mxGeometry></mxCell><mxCell id="c12" style="endArrow=block;endFill=1;startArrow=none;startFill=1;html=1;rounded=0;strokeColor=#8c8f98;strokeWidth=1.6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry"><mxPoint x="190" y="210" as="sourcePoint"/><mxPoint x="490" y="210" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c13" style="endArrow=block;endFill=1;startArrow=none;startFill=1;html=1;rounded=0;strokeColor=#8c8f98;strokeWidth=1.6;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c5"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="210" as="sourcePoint"/><mxPoint x="660" y="210" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c14" style="endArrow=block;endFill=1;startArrow=none;startFill=1;html=1;rounded=0;strokeColor=#8c8f98;strokeWidth=1.6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c3"><mxGeometry relative="1" as="geometry"><mxPoint x="785" y="240" as="sourcePoint"/><mxPoint x="115" y="240" as="targetPoint"/><Array as="points"><mxPoint x="785" y="270"/><mxPoint x="115" y="270"/></Array></mxGeometry></mxCell><mxCell id="legend-h" value="Legend" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#8c8f98;fontSize=11;fontStyle=1;fontFamily=IBM Plex Mono;" vertex="1" parent="1"><mxGeometry x="20" y="301" width="60" height="18" as="geometry"/></mxCell><mxCell id="lg88s" value="" style="rounded=1;arcSize=30;html=1;fillColor=none;strokeColor=#2fd4bf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="88" y="305" width="10" height="10" as="geometry"/></mxCell><mxCell id="lg88t" value="layer 2 placement" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="103" y="301" width="116" height="18" as="geometry"/></mxCell><mxCell id="caption" value="Dispatch, retry, heartbeat timeouts, attempt fencing and cancellation are Temporal&#x27;s own. The scheduler decides which pool queue and priority class; Temporal holds the backlog and the scheduler does not move messages. Option B, the fallback only if Temporal later fails a real need: ready tasks go to RabbitMQ class queues, the scheduler leases them to workers over HTTP long-poll, backed by a Postgres lease ledger with fencing." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="331" width="840" height="56" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
