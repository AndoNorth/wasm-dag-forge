<mxfile host="app.diagrams.net"><diagram id="d2" name="Two layers of scheduling"><mxGraphModel dx="880" dy="482" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="880" pageHeight="482" background="#0a1120" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Two layers of scheduling" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#c9cbd0;fontSize=20;fontStyle=1;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="840" height="32" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=5;html=1;whiteSpace=wrap;fillColor=#16243e;strokeColor=#0ca5e9;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="270" height="185" as="geometry"/></mxCell><mxCell id="c7" value="" style="rounded=1;arcSize=5;html=1;whiteSpace=wrap;fillColor=#152940;strokeColor=#2fd4bf;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="530" y="90" width="320" height="185" as="geometry"/></mxCell><mxCell id="c4" value="Backlog&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:11px&quot;&gt;up to 100,000 queued jobs&lt;/font&gt;" style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="50" y="130" width="230" height="50" as="geometry"/></mxCell><mxCell id="c5" value="Admission gate&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:11px&quot;&gt;priority, quota, per-class cap&lt;/font&gt;" style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="50" y="210" width="230" height="50" as="geometry"/></mxCell><mxCell id="c6" value="Live workflow&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:11px&quot;&gt;1 job becomes N tasks&lt;/font&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="330" y="165" width="170" height="60" as="geometry"/></mxCell><mxCell id="c8" value="Temporal task queues&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:11px&quot;&gt;hold the backlog, fairness weights&lt;/font&gt;" style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="550" y="130" width="280" height="50" as="geometry"/></mxCell><mxCell id="c9" value="Scheduler&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:11px&quot;&gt;picks pool queue and priority class&lt;/font&gt;" style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="550" y="210" width="280" height="50" as="geometry"/></mxCell><mxCell id="c10" value="Workers poll the chosen pool queue" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="550" y="300" width="280" height="40" as="geometry"/></mxCell><mxCell id="c11" value="LAYER 1 - JOB ADMISSION (unit: job)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Mono;spacing=0;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="42" y="97" width="239" height="18" a