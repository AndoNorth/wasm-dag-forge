"1" as="geometry"><mxPoint x="690" y="180" as="sourcePoint"/><mxPoint x="690" y="210" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c17" style="endArrow=block;endFill=1;startArrow=none;startFill=1;html=1;rounded=0;strokeColor=#8c8f98;strokeWidth=1.6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"><mxPoint x="690" y="260" as="sourcePoint"/><mxPoint x="690" y="300" as="targetPoint"/></mxGeometry></mxCell><mxCell id="legend-h" value="Legend" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#8c8f98;fontSize=11;fontStyle=1;fontFamily=IBM Plex Mono;" vertex="1" parent="1"><mxGeometry x="20" y="376" width="60" height="18" as="geometry"/></mxCell><mxCell id="lg88s" value="" style="rounded=1;arcSize=30;html=1;fillColor=none;strokeColor=#0ca5e9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="88" y="380" width="10" height="10" as="geometry"/></mxCell><mxCell id="lg88t" value="layer 1 admission" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="103" y="376" width="116" height="18" as="geometry"/></mxCell><mxCell id="lg233s" value="" style="rounded=1;arcSize=30;html=1;fillColor=none;strokeColor=#2fd4bf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="233" y="380" width="10" height="10" as="geometry"/></mxCell><mxCell id="lg233t" value="layer 2 placement" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="248" y="376" width="116" height="18" as="geometry"/></mxCell><mxCell id="caption" value="One submitted job passes through both layers. Layer 1 answers when a job may start. Layer 2 answers which pool queue runs each task and when. The scheduler holds no backlog of its own: the topology scout showed an in-memory backlog and capacity ledger overran its cap and inverted priority after a restart. It chooses the queue and priority attributes; Temporal&#x27;s matching service holds the waiting tasks." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="406" width="840" height="56" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
