<mxfile host="app.diagrams.net"><diagram id="13" name="State, envelope and artifacts"><mxGraphModel dx="960" dy="830" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="960" pageHeight="830" background="#0a1120" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="State, envelope and artifacts" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#c9cbd0;fontSize=20;fontStyle=1;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="920" height="32" as="geometry"/></mxCell><mxCell id="sub" value="Submit API&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:11px&quot;&gt;validates, then inserts&lt;/font&gt;" style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="140" height="58" as="geometry"/></mxCell><mxCell id="msg" value="Intake CloudEvent&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:10px&quot;&gt;dev.wdf.job.accepted.v1, pointer only&lt;/font&gt;" style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="225" y="70" width="180" height="58" as="geometry"/></mxCell><mxCell id="rec" value="Publish reconciler&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:11px&quot;&gt;rows without a receipt&lt;/font&gt;" style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="460" y="70" width="150" height="58" as="geometry"/></mxCell><mxCell id="tmp" value="Temporal workflow and activities" style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#16243e;strokeColor=#0ca5e9;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="650" y="70" width="280" height="58" as="geometry"/></mxCell><mxCell id="pg" value="" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;fillColor=#292541;strokeColor=#f4bf51;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="340" y="240" width="280" height="300" as="geometry"/></mxCell><mxCell id="n1" value="Postgres: accepted_jobs" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#c9cbd0;fontSize=12;fontStyle=1;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="352" y="246" width="260" height="20" as="geometry"/></mxCell><mxCell id="n2" value="tenant, submission_key&lt;br&gt;&lt;b&gt;unique constraint&lt;/b&gt;&lt;br&gt;&lt;br&gt;job_id, class: short or long&lt;br&gt;manifest_ref, schema_version&lt;br&gt;&lt;br&gt;publish_receipt&lt;br&gt;null until published&lt;br&gt;&lt;br&gt;job_status&lt;br&gt;accepted to terminal" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Mono;spacing=0;" vertex="1" parent="1"><mxGeometry x="352" y="270" width="256" height="260" as="geometry"/></mxCell><mxCell id="ts" value="" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;fillColor=#292541;strokeColor=#f4bf51;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="650" y="240" width="280" height="300" as="geometry"/></mxCell><mxCell id="n3" value="TimescaleDB: job_events" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#c9cbd0;fontSize=12;fontStyle=1;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="662" y="246" width="260" height="20" as="geometry"/></mxCell><mxCell id="n4" value="hypertable, append only&lt;br&gt;&lt;b&gt;unique (event_id, event_time)&lt;/b&gt;&lt;br&gt;event_id = source#id&lt;br&gt;event_time = time&lt;br&gt;&lt;br&gt;CloudEvent kept as received:&lt;br&gt;type, source, id, time, subject,&lt;br&gt;dataschema, data (refs only)&lt;br&gt;&lt;br&gt;CloudEvent types, for example:&lt;br&gt;dev.wdf.job.accepted.v1&lt;br&gt;dev.wdf.task.placed.v1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Mono;spacing=0;" vertex="1" parent="1"><mxGeometry x="662" y="270" width="256" height="260" as="geometry"/></mxCell><mxCell id="os" value="" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#8c8f98;strokeWidth=1.5;dashed=1;dashPattern=5 4;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="240" width="280" height="300" as="geometry"/></mxCell><mxCell id="n5" value="Object storage: four S3 buckets" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#c9cbd0;fontSize=12;fontStyle=1;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="42" y="246" width="260" height="20" as="geometry"/></mxCell><mxCell id="n6" value="product left open, pluggable" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="42" y="264" width="260" height="18" as="geometry"/></mxCell><mxCell id="o1" value="Job manifest and source bundle&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:11px&quot;&gt;wdf-sources, immutable, content-addressed&lt;/font&gt;" style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#292541;strokeColor=#f4bf51;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="45" y="290" width="250" height="54" as="geometry"/></mxCell><mxCell id="o2" value="Compiled components&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:11px&quot;&gt;wdf-components, reused on a cache hit&lt;/font&gt;" style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#292541;strokeColor=#f4bf51;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="45" y="352" width="250" height="54" as="geometry"/></mxCell><mxCell id="o3" value="Per-seed results&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:11px&quot;&gt;wdf-results, XML blocks, hash verified&lt;/font&gt;" style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#292541;strokeColor=#f4bf51;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="45" y="414" width="250" height="54" as="geometry"/></mxCell><mxCell id="o4" value="Checkpoint refs&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:11px&quot;&gt;wdf-checkpoints, last one resumes a paused job&lt;/font&gt;" style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#292541;strokeColor=#f4bf51;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="45" y="476" width="250" height="54" as="geometry"/></mxCell><mxCell id="wrk" value="Workers&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:11px&quot;&gt;simulate writes results, aggregate reads them through the aggregate index&lt;/font&gt;" style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#152940;strokeColor=#2fd4bf;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="600" width="280" height="58" as="geometry"/></mxCell><mxCell id="ctl" value="Control API&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:11px&quot;&gt;cancel, pause, resume, terminate&lt;/font&gt;" style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="340" y="600" width="280" height="58" as="geometry"/></mxCell><mxCell id="graf" value="Dashboards and queries&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:11px&quot;&gt;read event history&lt;/font&gt;" style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="650" y="600" width="280" height="58" as="geometry"/></mxCell><mxCell id="e1" style="endArrow=block;endFill=1;startArrow=none;startFill=1;html=1;rounded=0;strokeColor=#8c8f98;strokeWidth=1.6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sub" target="msg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n7" value="publish" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="172" y="76" width="55" height="18" as="geometry"/></mxCell><mxCell id="e2" style="endArrow=block;endFill=1;startArrow=none;startFill=1;html=1;rounded=0;strokeColor=#8c8f98;strokeWidth=1.6;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;ent