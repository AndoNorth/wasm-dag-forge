metry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n11" value="set receipt" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="543" y="160" width="66" height="18" as="geometry"/></mxCell><mxCell id="e6" style="endArrow=block;endFill=1;startArrow=none;startFill=1;html=1;rounded=0;strokeColor=#8c8f98;strokeWidth=1.6;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.9;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="tmp" target="pg"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="706" y="190"/><mxPoint x="592" y="190"/></Array></mxGeometry></mxCell><mxCell id="n12" value="job status" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="622" y="168" width="80" height="18" as="geometry"/></mxCell><mxCell id="e7" style="endArrow=block;endFill=1;startArrow=none;startFill=1;html=1;rounded=0;strokeColor=#8c8f98;strokeWidth=1.6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="tmp" target="ts"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n13" value="append events" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="798" y="160" width="100" height="18" as="geometry"/></mxCell><mxCell id="e8" style="endArrow=block;endFill=1;startArrow=block;startFill=1;html=1;rounded=0;strokeColor=#8c8f98;strokeWidth=1.6;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctl" target="pg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n14" value="acts on job row first" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="488" y="562" width="120" height="18" as="geometry"/></mxCell><mxCell id="e9" style="endArrow=block;endFill=1;startArrow=none;startFill=1;html=1;rounded=0;strokeColor=#8c8f98;strokeWidth=1.6;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="graf" target="ts"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n15" value="read history" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="798" y="562" width="100" height="18" as="geometry"/></mxCell><mxCell id="e10" style="endArrow=block;endFill=1;startArrow=block;startFill=1;html=1;rounded=0;strokeColor=#2fd4bf;strokeWidth=1.6;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="wrk" target="os"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n16" value="sources, components, results, checkpoints" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="163" y="562" width="260" height="18" as="geometry"/></mxCell><mxCell id="legend-h" value="Legend" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontStyle=1;fontFamily=IBM Plex Mono;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="690" width="60" height="18" as="geometry"/></mxCell><mxCell id="lg0s" value="" style="rounded=1;arcSize=30;html=1;fillColor=none;strokeColor=#252b39;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="88" y="694" width="10" height="10" as="geometry"/></mxCell><mxCell id="lg0t" value="service" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="103" y="690" width="47" height="18" as="geometry"/></mxCell><mxCell id="lg1s" value="" style="rounded=1;arcSize=30;html=1;fillColor=none;strokeColor=#0ca5e9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="164" y="694" width="10" height="10" as="geometry"/></mxCell><mxCell id="lg1t" value="Temporal" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="179" y="690" width="52" height="18" as="geometry"/></mxCell><mxCell id="lg2s" value="" style="rounded=1;arcSize=30;html=1;fillColor=none;strokeColor=#2fd4bf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="245" y="694" width="10" height="10" as="geometry"/></mxCell><mxCell id="lg2t" value="workers" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="260" y="690" width="47" height="18" as="geometry"/></mxCell><mxCell id="lg3s" value="" style="rounded=1;arcSize=30;html=1;fillColor=none;strokeColor=#f4bf51;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="321" y="694" width="10" height="10" as="geometry"/></mxCell><mxCell id="lg3t" value="durable state" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="336" y="690" width="80" height="18" as="geometry"/></mxCell><mxCell id="lg4s" value="" style="rounded=1;arcSize=30;html=1;fillColor=none;strokeColor=#8c8f98;strokeWidth=1.5;dashed=1;dashPattern=3 2;" vertex="1" parent="1"><mxGeometry x="430" y="694" width="10" height="10" as="geometry"/></mxCell><mxCell id="lg4t" value="planned or open choice" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="445" y="690" width="131" height="18" as="geometry"/></mxCell><mxCell id="caption" value="Submit inserts the accepted-jobs row first, then publishes the pointer message (a CloudEvent), and the reconciler republishes rows that have no publish receipt. One unique constraint on tenant and submission key dedups at submit. Temporal owns job lifecycle, Postgres holds the row of record and the event history is append only. The envelope carries identity and refs, never accumulated state. Object storage keeps one bucket per data class: sources, components, results and checkpoints." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="724" width="920" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>