="endArrow=none;html=1;strokeColor=#8c8f98;strokeWidth=1.6;dashed=1;dashPattern=5 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="378" y="605" as="sourcePoint"/><mxPoint x="400" y="605" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lg378t" value="dashed = planned or optional, solid = required behaviour" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="406" y="596" width="350" height="18" as="geometry"/></mxCell><mxCell id="lg770s" value="" style="rounded=1;arcSize=30;html=1;fillColor=none;strokeColor=#f4bf51;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="770" y="600" width="10" height="10" as="geometry"/></mxCell><mxCell id="lg770t" value="open decision / attention" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="785" y="596" width="164" height="18" as="geometry"/></mxCell><mxCell id="caption" value="The Dispatch API writes each accepted job to TimescaleDB, then publishes it to intake; admission releases jobs to Temporal as capacity allows, so 100,000 submissions wait in a queue instead of becoming 100,000 live workflows. Temporal asks the scheduler to place each task, then schedules it on the chosen pool&#x27;s Temporal task queue; workers poll it directly. The scheduler never moves messages. The dashed top path is the control plane." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="626" width="840" height="72" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
