46" value="" style="rounded=1;arcSize=30;html=1;fillColor=none;strokeColor=#0ca5e9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="271" y="644" width="10" height="10" as="geometry"/></mxCell><mxCell id="c47" value="pinned by the flake or the justfile" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="286" y="640" width="190" height="18" as="geometry"/></mxCell><mxCell id="c48" value="" style="rounded=1;arcSize=30;html=1;fillColor=none;strokeColor=#2fd4bf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="494" y="644" width="10" height="10" as="geometry"/></mxCell><mxCell id="c49" value="handed to epic 2" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="509" y="640" width="90" height="18" as="geometry"/></mxCell><mxCell id="c50" value="" style="rounded=1;arcSize=30;html=1;fillColor=none;strokeColor=#f4bf51;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="617" y="644" width="10" height="10" as="geometry"/></mxCell><mxCell id="c51" value="open decision" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="632" y="640" width="80" height="18" as="geometry"/></mxCell><mxCell id="c52" style="endArrow=none;html=1;strokeColor=#8c8f98;strokeWidth=1.6;dashed=1;dashPattern=5 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="649" as="sourcePoint"/><mxPoint x="752" y="649" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c53" value="optional" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="760" y="640" width="50" height="18" as="geometry"/></mxCell><mxCell id="caption" value="Everything except Nix, the Docker engine and WSL2 comes from the flake. just doctor fails if a tool on PATH is not from /nix/store, so a host copy of kind, kubectl or helm cannot shadow a pinned one. Runtime artifacts (chart, image, kind node image) are pinned in one versions file, tools by flake.lock and Python packages by uv.lock." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="670" width="840" height="52" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>