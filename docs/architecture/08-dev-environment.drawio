es&lt;br&gt;&lt;font color="#8c8f98" style="font-size:11px"&gt;nix-command flakes enabled&lt;/font&gt;' style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fillColor=#212240;strokeColor=#fb7085;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="242" y="100" width="186" height="58" as="geometry"/></mxCell><mxCell id="c7" value='Docker engine&lt;br&gt;&lt;font color="#8c8f98" style="font-size:11px"&gt;docker-ce, runs the kind nodes&lt;/font&gt;' style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fillColor=#212240;strokeColor=#fb7085;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="448" y="100" width="186" height="58" as="geometry"/></mxCell><mxCell id="c8" value='Repo on WSL ext4&lt;br&gt;&lt;font color="#8c8f98" style="font-size:11px"&gt;not /mnt/c, inotify limit 512&lt;/font&gt;' style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fillColor=#212240;strokeColor=#fb7085;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="654" y="100" width="186" height="58" as="geometry"/></mxCell><mxCell id="c10" value="" style="rounded=1;arcSize=5;html=1;whiteSpace=wrap;fillColor=#16243e;strokeColor=#0ca5e9;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="200" width="490" height="250" as="geometry"/></mxCell><mxCell id="c11" value="Nix flake dev shell, tools pinned by flake.lock" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="32" y="206" width="400" height="18" as="geometry"/></mxCell><mxCell id="c12" value='flake.nix + flake.lock&lt;br&gt;&lt;font color="#8c8f98" style="font-size:11px"&gt;nixos-26.05 pin&lt;/font&gt;' style="rounded=1;arcSize=13;html=1;whiteSpa