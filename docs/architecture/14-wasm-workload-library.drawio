;" vertex="1" parent="1"><mxGeometry x="409" y="710" width="52" height="18" as="geometry"/></mxCell><mxCell id="lg4s" value="" style="rounded=1;arcSize=30;html=1;fillColor=none;strokeColor=#fb7085;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="475" y="714" width="10" height="10" as="geometry"/></mxCell><mxCell id="lg4t" value="failure path" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="490" y="710" width="75" height="18" as="geometry"/></mxCell><mxCell id="lg5s" value="" style="rounded=1;arcSize=30;html=1;fillColor=none;strokeColor=#8c8f98;strokeWidth=1.5;dashed=1;dashPattern=3 2;" vertex="1" parent="1"><mxGeometry x="579" y="714" width="10" height="10" as="geometry"/></mxCell><mxCell id="lg5t" value="test only" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="594" y="710" width="58" height="18" as="geometry"/></mxCell><mxCell id="caption" value="Each workload is a pure kernel plus a thin adapter, compiled once into a content-addressed component. The runner mounts inputs and outputs, reads heartbeat lines from stderr, uploads checkpoints and artifacts, and maps the exit code to a failure class. A resumed attempt starts the same guest with the last checkpoint." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="744" width="920" height="52" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>