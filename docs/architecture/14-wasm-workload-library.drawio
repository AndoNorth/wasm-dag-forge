ometry x="290" y="936" width="10" height="10" as="geometry"/></mxCell><mxCell id="lg2t" value="durable state" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="305" y="932" width="80" height="18" as="geometry"/></mxCell><mxCell id="lg3s" value="" style="rounded=1;arcSize=30;html=1;fillColor=none;strokeColor=#0ca5e9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="399" y="936" width="10" height="10" as="geometry"/></mxCell><mxCell id="lg3t" value="Temporal" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="414" y="932" width="52" height="18" as="geometry"/></mxCell><mxCell id="lg4s" value="" style="rounded=1;arcSize=30;html=1;fillColor=none;strokeColor=#fb7085;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="480" y="936" width="10" height="10" as="geometry"/></mxCell><mxCell id="lg4t" value="failure path" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="495" y="932" width="75" height="18" as="geometry"/></mxCell><mxCell id="lg5s" value="" style="rounded=1;arcSize=30;html=1;fillColor=none;strokeColor=#8c8f98;strokeWidth=1.5;dashed=1;dashPattern=3 2;" vertex="1" parent="1"><mxGeometry x="584" y="936" width="10" height="10" as="geometry"/></mxCell><mxCell id="lg5t" value="planned or test only" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="599" y="932" width="120" height="18" as="geometry"/></mxCell><mxCell id="caption" value="The author pushes a source bundle with locked dependencies. A native compile task builds it into a component, or the stored one is reused when the compile-cache key (source hash, lockfile hash, componentize-py version, WIT contract version) matches. Each execution gets a fresh instance of that component in stock wasmtime, as a plain command component with an input file, result files, an exit code and a stderr heartbeat. The aggregate is a native task and is not a WASM component. Limits apply to compile and execution alike." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="966" width="920" height="72" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>