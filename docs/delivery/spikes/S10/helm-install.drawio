        <mxCell id="host" value="&lt;b&gt;host&lt;/b&gt;: load.py, workflow worker and pool worker, 3,000 jobs, 100 in flight, 13.8 jobs/s, 0 failed&lt;br&gt;through a port-forward on 127.0.0.1 to temporal-frontend:7233" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
