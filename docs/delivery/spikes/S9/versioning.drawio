    <mxCell id="D1" value="count of pinned running on wdf-workflow-worker:A: 2 before B, 1 after the override" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="D">
