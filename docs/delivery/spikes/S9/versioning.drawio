    <mxCell id="W" value="Pinned workflows on queue wdf-workflow" style="swimlane;startSize=30;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="20" y="190" width="1000" height="300" as="geometry"/>
    </mxCell>
    <mxCell id="S1" value="stays-on-a: started on A, waits on the signal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="W">
      <mxGeometry x="20" y="45" width="280" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="S2" value="Finishes on A while B is current: versions A, A, A, A, step finish-buggy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="W">
      <mxGeometry x="700" y="45" width="280" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="M1" value="moved-to-b: started on A, waits on the signal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="W">
      <mxGeometry x="20" y="125" width="280" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="M2" value="Override: update_workflow_execution_options, mask versioning_override, PinnedVersioningOverride to B. One new event (OPTIONS_UPDATED), no task, search attribute already B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="W">
      <mxGeometry x="330" y="110" width="340" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="M3" value="Signal, B replays the history and completes: versions A, A, B, B, step finish-fixed, 1 patch marker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="W">
      <mxGeometry x="700" y="125" width="280" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="C1" value="moved-to-c: started on B, override to C, whose change before the signal is unguarded" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="W">
      <mxGeometry x="20" y="215" width="280" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="C2" value="Task fails NON_DETERMINISTIC_ERROR (TMPRL1100), workflow stays RUNNING" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="W">
