<mxGraphModel adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="t" value="Task path of a two-task job: a worked example from wdf_workflow.job and wdf_workflow.taskpath" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1140" height="30" as="geometry"/></mxCell>
    <mxCell id="a" value="Job 1: a cache miss" style="swimlane;startSize=30;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="580" height="790" as="geometry"/></mxCell>
    <mxCell id="a0" value="&lt;b&gt;1. load_plan, control activity on wdf-control-test-build&lt;/b&gt;&lt;br&gt;manifest of the accepted event, bound to the params block: build (compile), sim-a (simulate, depends on build), max_parallel 8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="a"><mxGeometry x="10" y="40" width="560" height="60" as="geometry"/></mxCell>
    <mxCell id="a1" value="&lt;b&gt;2. emit, local activity&lt;/b&gt;&lt;br&gt;job.started, row admitted to running" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="a"><mxGeometry x="10" y="115" width="560" height="60" as="geometry"/></mxCell>
    <mxCell id="a2" value="&lt;b&gt;3. ready loop&lt;/b&gt;&lt;br&gt;ready [build], 0 of 8 running, so build starts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="a"><mxGeometry x="10" y="190" width="560" height="60" as="geometry"/></mxCell>
    <mxCell id="a3" value="&lt;b&gt;4. cache_lookup, control activity&lt;/b&gt;&lt;br&gt;source sha256 aaaa...aaaa, entry sim: miss, key 5a965af2...641e" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="a"><mxGeometry x="10" y="265" width="560" height="60" as="geometry"/></mxCell>
    <mxCell id="a4" value="&lt;b&gt;5. place, local activity through StaticPlacer, answer kept as a marker&lt;/b&gt;&lt;br&gt;compile 1000m 1024 MiB: wdf-compile, 1024Mi, schedule-to-start 1800 s, start-to-close 600 + 120 = 720 s, heartbeat 60 s; emit task.placed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="a"><mxGeometry x="10" y="340" width="560" height="60" as="geometry"/></mxCell>
    <mxCell id="a5" value="&lt;b&gt;6. run_task on wdf-compile, one attempt, WAIT_CANCELLATION_COMPLETED&lt;/b&gt;&lt;br&gt;task_attempt 1, resume_counter 0, cache_key 5a965af2...641e: component, build-info and log tail references" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="a"><mxGeometry x="10" y="415" width="560" height="60" as="geometry"/></mxCell>
    <mxCell id="a6" value="&lt;b&gt;7. commit r0a1, then cache_record&lt;/b&gt;&lt;br&gt;component and build-info become the entry of key 5a965af2...641e; emit task.started at the worker's started_at, task.succeeded" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="a"><mxGeometry x="10" y="490" width="560" height="60" as="geometry"/></mxCell>
    <mxCell id="a7" value="&lt;b&gt;8. settle&lt;/b&gt;&lt;br&gt;sim-a ready: place answers wdf-simulate, 384Mi, 720 s, 60 s; run_task with inputs [the component of build]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="a"><mxGeometry x="10" y="565" width="560" height="60" as="geometry"/></mxCell>
    <mxCell id="a8" value="&lt;b&gt;9. commit r0a1 of sim-a&lt;/b&gt;&lt;br&gt;result and log tail; emit task.started, task.succeeded, task.result.ready" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="a"><mxGeometry x="10" y="640" width="560" height="60" as="geometry"/></mxCell>
    <mxCell id="a9" value="&lt;b&gt;10. outcome succeeded&lt;/b&gt;&lt;br&gt;emit job.succeeded, row running to succeeded" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="a"><mxGeometry x="10" y="715" width="560" height="60" as="geometry"/></mxCell>
    <mxCell id="a0-a1" style="html=1;endArrow=block;" edge="1" parent="a" source="a0" target="a1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="a1-a2" style="html=1;endArrow=block;" edge="1" parent="a" source="a1" target="a2"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="a2-a3" style="html=1;endArrow=block;" edge="1" parent="a" source="a2" target="a3"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="a3-a4" style="html=1;endArrow=block;" edge="1" parent="a" source="a3" target="a4"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="a4-a5" style="html=1;endArrow=block;" edge="1" parent="a" source="a4" target="a5"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="a5-a6" style="html=1;endArrow=block;" edge="1" parent="a" source="a5" target="a6"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="a6-a7" style="html=1;endArrow=block;" edge="1" parent="a" source="a6" target="a7"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="a7-a8" style="html=1;endArrow=block;" edge="1" parent="a" source="a7" target="a8"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="a8-a9" style="html=1;endArrow=block;" edge="1" parent="a" source="a8" target="a9"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="b" value="Job 2: the same source, after job 1" style="swimlane;startSize=30;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="640" y="60" width="520" height="415" as="geometry"/></mxCell>
    <mxCell id="b0" value="&lt;b&gt;1. load_plan and job.started, as job 1&lt;/b&gt;&lt;br&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="b"><mxGeometry x="10" y="40" width="500" height="60" as="geometry"/></mxCell>
    <mxCell id="b1" value="&lt;b&gt;2. cache_lookup, control activity&lt;/b&gt;&lt;br&gt;same source and entry: hit, key 5a965af2...641e, the component linked to job 2 with cache.use" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="b"><mxGeometry x="10" y="115" width="500" height="60" as="geometry"/></mxCell>
    <mxCell id="b2" value="&lt;b&gt;3. emit task.skipped&lt;/b&gt;&lt;br&gt;reason compile-cache-hit, cache_key 5a965af2...641e; build is skipped with task_attempt 0, no place and no run_task" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="b"><mxGeometry x="10" y="190" width="500" height="60" as="geometry"/></mxCell>
    <mxCell id="b3" value="&lt;b&gt;4. settle&lt;/b&gt;&lt;br&gt;sim-a ready at once: place answers wdf-simulate; run_task with inputs [the cached component]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="b"><mxGeometry x="10" y="265" width="500" height="60" as="geometry"/></mxCell>
    <mxCell id="b4" value="&lt;b&gt;5. outcome succeeded&lt;/b&gt;&lt;br&gt;emit job.succeeded" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="b"><mxGeometry x="10" y="340" width="500" height="60" as="geometry"/></mxCell>
    <mxCell id="b0-b1" style="html=1;endArrow=block;" edge="1" parent="b" source="b0" target="b1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="b1-b2" style="html=1;endArrow=block;" edge="1" parent="b" source="b1" target="b2"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="b2-b3" style="html=1;endArrow=block;" edge="1" parent="b" source="b2" target="b3"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="b3-b4" style="html=1;endArrow=block;" edge="1" parent="b" source="b3" target="b4"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="rec" value="the entry&lt;br&gt;job 1&lt;br&gt;recorded" style="html=1;endArrow=block;dashed=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a6" target="b1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="620" y="580"/><mxPoint x="620" y="205"/></Array></mxGeometry></mxCell>
    <mxCell id="l0" value="workflow code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="640" y="520" width="120" height="30" as="geometry"/></mxCell>
    <mxCell id="l1" value="local activity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="770" y="520" width="120" height="30" as="geometry"/></mxCell>
    <mxCell id="l2" value="control activity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="900" y="520" width="120" height="30" as="geometry"/></mxCell>
    <mxCell id="l3" value="pool activity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="1030" y="520" width="120" height="30" as="geometry"/></mxCell>
  </root>
</mxGraphModel>
