    <mxCell id="t" value="wdf_workflow.harness: the scenarios, worked example from the T2 runs on kind-wdf at commit a4efd0d" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1240" height="30" as="geometry"/></mxCell>
    <mxCell id="job" value="A smoke job" style="swimlane;startSize=30;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="610" height="190" as="geometry"/></mxCell>
