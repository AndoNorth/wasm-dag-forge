    <mxCell id="jn" value="Even jobs share one source bundle, so their compile hits the cache once one recorded it. Odd jobs each have their own." style="text;html=1;whiteSpace=wrap;align=left;fontSize=11;fontColor=#666666;" vertex="1" parent="job"><mxGeometry x="20" y="140" width="570" height="40" as="geometry"/></mxCell>
    <mxCell id="adm" value="What the harness does as admission (T2)" style="swimlane;startSize=30;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="650" y="50" width="610" height="190" as="geometry"/></mxCell>
    <mxCell id="a1" value="&lt;b&gt;seed&lt;/b&gt;: job row at accepted (superuser), manifest and source bundle.tar put by &lt;i&gt;submit&lt;/i&gt;, indexed and linked to the job, row claimed accepted to admitted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacingLeft=6;" vertex="1" parent="adm"><mxGeometry x="20" y="40" width="570" height="45" as="geometry"/></mxCell>
    <mxCell id="a2" value="&lt;b&gt;start&lt;/b&gt;: JobWorkflow on wdf-workflow, id workflow_id(job), REJECT_DUPLICATE, the five search attributes; the deployed build made current when none is" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacingLeft=6;" vertex="1" parent="adm"><mxGeometry x="20" y="90" width="570" height="45" as="geometry"/></mxCell>
    <mxCell id="a3" value="&lt;b&gt;pools&lt;/b&gt;: one FakePool per pool on the host, with the compile, simulate and aggregate store identities, through port-forwards on 127.0.0.1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacingLeft=6;" vertex="1" parent="adm"><mxGeometry x="20" y="140" width="570" height="40" as="geometry"/></mxCell>
    <mxCell id="h1" value="Scenario" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="260" width="230" height="30" as="geometry"/></mxCell>
    <mxCell id="h2" value="What the pools do" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="250" y="260" width="330" height="30" as="geometry"/></mxCell>
    <mxCell id="h3" value="What it kills or replaces" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="580" y="260" width="330" height="30" as="geometry"/></mxCell>
    <mxCell id="h4" value="Printed on kind-wdf" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="910" y="260" width="350" height="30" as="geometry"/></mxCell>
    <mxCell id="r1a" value="&lt;b&gt;smoke --jobs 200&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="20" y="290" width="230" height="60" as="geometry"/></mxCell>
    <mxCell id="r1b" value="every attempt succeeds" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="250" y="290" width="330" height="60" as="geometry"/></mxCell>
    <mxCell id="r1c" value="nothing" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="580" y="290" width="330" height="60" as="geometry"/></mxCell>
    <mxCell id="r1d" value="finished: 200, failed: 0, infra_retries: 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=6;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="910" y="290" width="350" height="60" as="geometry"/></mxCell>
    <mxCell id="r2a" value="&lt;b&gt;smoke --scenario zombie --jobs 20&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="20" y="350" width="230" height="70" as="geometry"/></mxCell>
    <mxCell id="r2b" value="sim-1 attempt 1 of each job is a Zombie: no beat, completes after 75 s, uploads its outputs" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="250" y="350" width="330" height="70" as="geometry"/></mxCell>
    <mxCell id="r2c" value="its attempt: heartbeat timeout at 60 s, infra retry r0a2 succeeds and is the one committed; the index holds no row of r0a1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="580" y="350" width="330" height="70" as="geometry"/></mxCell>
    <mxCell id="r2d" value="finished: 20, failed: 0, infra_retries: 20, zombie_commits: 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=6;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="910" y="350" width="350" height="70" as="geometry"/></mxCell>
    <mxCell id="r3a" value="&lt;b&gt;restart --jobs 200 --target&lt;/b&gt; temporal-frontend, -history, -matching, -worker, workflow-worker &lt;b&gt;--scenario worker-death --deaths 5&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="20" y="420" width="230" height="90" as="geometry"/></mxCell>
    <mxCell id="r3b" value="simulate attempts take 5 s; the first 5 simulate attempts Die (never beat, never complete)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="250" y="420" width="330" height="90" as="geometry"/></mxCell>
    <mxCell id="r3c" value="once simulate tasks run: every target pod deleted at once, waited for Ready again, the forward to the frontend opened again on its port" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="580" y="420" width="330" height="90" as="geometry"/></mxCell>
    <mxCell id="r3d" value="finished: 200, failed: 0, infra_retries: 5, in_flight: 13, restarted: the five targets" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=6;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="910" y="420" width="350" height="90" as="geometry"/></mxCell>
    <mxCell id="r4a" value="&lt;b&gt;rollout&lt;/b&gt; with WDF_BUILD_ID=v3-c, current v3-b" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="20" y="510" width="230" height="90" as="geometry"/></mxCell>
    <mxCell id="r4b" value="the simulate pool is served only after v3-c is current, so the open job waits on wdf-simulate across the rollout" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="250" y="510" width="330" height="90" as="geometry"/></mxCell>
    <mxCell id="r4c" value="image.sh builds v3-c, pushed to localhost:5001, a copy of workflow-worker-v3-b applied as workflow-worker-v3-c, set_current(v3-c), then retire(v3-b) deletes the old Deployment once drained" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="580" y="510" width="330" height="90" as="geometry"/></mxCell>
    <mxCell id="r4d" value="old_build: v3-b, new_build: v3-c, open_job_build: v3-b, new_job_build: v3-c, drained: v3-b, then deleted" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=6;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="910" y="510" width="350" height="90" as="geometry"/></mxCell>
    <mxCell id="r5a" value="&lt;b&gt;smoke --scenario pause-resume&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="20" y="600" width="230" height="70" as="geometry"/></mxCell>
    <mxCell id="r5b" value="simulate attempts take 5 s, so the pause lands while they run" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="250" y="600" width="330" height="70" as="geometry"/></mxCell>
    <mxCell id="r5c" value="request_action pause, signal pause with control_seq; once paused, request_action resume, row to resume-pending, signal resume" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="580" y="600" width="330" height="70" as="geometry"/></mxCell>
    <mxCell id="r5d" value="planned: exit 2 until JobWorkflow has the pause and resume signals; would print paused_resumed:" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;spacingLeft=6;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="910" y="600" width="350" height="70" as="geometry"/></mxCell>
    <mxCell id="t1" value="At T1 (--address), the harness runs the workflow worker itself with FakeControl and seeds nothing: restart --target workflow-worker --jobs 4 prints finished: 4, failed: 0, in_flight: 4, and zombie and pause-resume exit 2. describe on kind-wdf prints namespace: wdf, retention: 24h, five search_attribute: lines and schedule: wdf-artifact-reaper." style="text;html=1;whiteSpace=wrap;align=left;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="680" width="1240" height="40" as="geometry"/></mxCell>
  </root>
