<mxGraphModel adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="t" value="Control activities on wdf-control-&amp;lt;build id&amp;gt;: login, store role and a worked example from the tests of wdf_workflow.activities" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1340" height="30" as="geometry"/></mxCell>
    <mxCell id="wf" value="JobWorkflow&lt;br&gt;queue wdf-workflow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="300" width="150" height="60" as="geometry"/></mxCell>
    <mxCell id="emit" value="&lt;b&gt;emit&lt;/b&gt; (local activity)&lt;br&gt;login in wdf_workflow&lt;br&gt;no store" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="420" width="150" height="60" as="geometry"/></mxCell>
    <mxCell id="e0" style="html=1;endArrow=block;" edge="1" parent="1" source="wf" target="emit"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="q" value="Control activity worker, queue wdf-control-&amp;lt;build id&amp;gt;, login in wdf_artifacts" style="swimlane;startSize=30;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="220" y="60" width="440" height="590" as="geometry"/></mxCell>
    <mxCell id="a1" value="&lt;b&gt;cache_lookup&lt;/b&gt;&lt;br&gt;store: workflow (reads the bundle, HEADs the wasm)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="q"><mxGeometry x="20" y="45" width="400" height="50" as="geometry"/></mxCell>
    <mxCell id="a2" value="&lt;b&gt;commit&lt;/b&gt;&lt;br&gt;store: workflow (HEAD of each output)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="q"><mxGeometry x="20" y="135" width="400" height="50" as="geometry"/></mxCell>
    <mxCell id="a3" value="&lt;b&gt;cache_record&lt;/b&gt;&lt;br&gt;store: workflow (reads build-info.json)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="q"><mxGeometry x="20" y="225" width="400" height="50" as="geometry"/></mxCell>
    <mxCell id="a4" value="&lt;b&gt;cache_invalidate&lt;/b&gt;&lt;br&gt;no store, SELECT ... FOR UPDATE then retire" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="q"><mxGeometry x="20" y="315" width="400" height="50" as="geometry"/></mxCell>
    <mxCell id="a5" value="&lt;b&gt;index_checkpoint&lt;/b&gt;&lt;br&gt;no store (workflow has no access to wdf-checkpoints)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="q"><mxGeometry x="20" y="405" width="400" height="50" as="geometry"/></mxCell>
    <mxCell id="a6" value="&lt;b&gt;build_index&lt;/b&gt;&lt;br&gt;store: indexer (put_index), workflow (commit with no attempt)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="q"><mxGeometry x="20" y="495" width="400" height="50" as="geometry"/></mxCell>
    <mxCell id="e1" style="html=1;endArrow=block;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="wf" target="q"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="x1" value="key c523632e...86dd for wdf_workloads.main (equal to python -m wdf_compile build)&lt;br&gt;job 1: miss, key returned. job 2: hit, component and build-info linked to job 2&lt;br&gt;store down: STORE_UNAVAILABLE, never a miss. No uv.lock: key null. Wasm gone: miss, entry retired" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="700" y="105" width="660" height="60" as="geometry"/></mxCell>
    <mxCell id="x2" value="accepted r0a2 of sim-1: result and log tail indexed&lt;br&gt;a result of r0a1 (zombie) in the batch: CommitRefused, nothing indexed&lt;br&gt;a missing log tail: OUTPUT_UPLOAD_FAILED (retryable), nothing indexed" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="700" y="195" width="660" height="60" as="geometry"/></mxCell>
    <mxCell id="x3" value="build-info.json says cache_key ffff...ffff, the key is c523...: CommitRefused, no entry&lt;br&gt;build-info of the key for another component: CommitRefused. Matching: recorded, first writer wins" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="700" y="290" width="660" height="50" as="geometry"/></mxCell>
    <mxCell id="x4" value="entry names component old, lost: invalidate(key, old) = true&lt;br&gt;a rival job waits on the row lock, then finds no live entry naming old: false&lt;br&gt;the rival records its rebuild, so the entry names component fresh" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="700" y="375" width="660" height="60" as="geometry"/></mxCell>
    <mxCell id="x5" value="checkpoint of sim-1 r1a2 for attempt r1a2: indexed&lt;br&gt;checkpoint of r0a1, of sim-2 or of another job for sim-1 r0a2: CommitRefused" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="700" y="470" width="660" height="50" as="geometry"/></mxCell>
    <mxCell id="x6" value="recorded results in the order sim-3, sim-10, sim-1, sim-2&lt;br&gt;index lines in task id order sim-1, sim-10, sim-2, sim-3, any order giving one object&lt;br&gt;index row live with no producer, linked to the job&lt;br&gt;a result of another job, or a failed entry when partial is refused: CommitRefused" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="700" y="555" width="660" height="70" as="geometry"/></mxCell>
    <mxCell id="l1" style="html=1;endArrow=none;dashed=1;" edge="1" parent="1" source="a1" target="x1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="l2" style="html=1;endArrow=none;dashed=1;" edge="1" parent="1" source="a2" target="x2"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="l3" style="html=1;endArrow=none;dashed=1;" edge="1" parent="1" source="a3" target="x3"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="l4" style="html=1;endArrow=none;dashed=1;" edge="1" parent="1" source="a4" target="x4"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="l5" style="html=1;endArrow=none;dashed=1;" edge="1" parent="1" source="a5" target="x5"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="l6" style="html=1;endArrow=none;dashed=1;" edge="1" parent="1" source="a6" target="x6"><mxGeometry relative="1" as="geometry"/></mxCell>
