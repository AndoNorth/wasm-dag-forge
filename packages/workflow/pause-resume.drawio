<mxGraphModel adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="t" value="Pause and resume: a worked example from wdf_workflow.job, with the values of test_pause.py" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1260" height="30" as="geometry"/></mxCell>
    <mxCell id="a" value="Resume from the checkpoint head: one checkpoint-capable sim, retries 1" style="swimlane;startSize=30;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="620" height="706" as="geometry"/></mxCell>
    <mxCell id="a0" value="&lt;b&gt;1. r0a1 fails timeout, hands over checkpoint c1&lt;/b&gt;&lt;br&gt;indexed, task.checkpoint.committed; guest budget 1 to 0; kept checkpoints [c1]" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="a"><mxGeometry x="10" y="40" width="600" height="56" as="geometry"/></mxCell>
    <mxCell id="a1" value="&lt;b&gt;2. r0a2 starts from c1, fails timeout, hands over c2&lt;/b&gt;&lt;br&gt;guest budget exhausted, plan checkpoint flag set: sim paused, task.retries.exhausted; kept [c2, c1]" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="a"><mxGeometry x="10" y="114" width="600" height="56" as="geometry"/></mxCell>
    <mxCell id="ae1" style="endArrow=block;html=1;" edge="1" parent="a" source="a0" target="a1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="a2" value="&lt;b&gt;3. job.paused, row running to paused&lt;/b&gt;&lt;br&gt;nothing runs: reason retries-exhausted, resume_counter 0" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="a"><mxGeometry x="10" y="188" width="600" height="56" as="geometry"/></mxCell>
    <mxCell id="ae2" style="endArrow=block;html=1;" edge="1" parent="a" source="a1" target="a2"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="a3" value="&lt;b&gt;4. paused: wait_condition on resume or cancel, no timer&lt;/b&gt;&lt;br&gt;history length unchanged over a 60 s pause (test_paused_costs_no_history)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="a"><mxGeometry x="10" y="262" width="600" height="56" as="geometry"/></mxCell>
    <mxCell id="ae3" style="endArrow=block;html=1;" edge="1" parent="a" source="a2" target="a3"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="a4" value="&lt;b&gt;5. control moves the row paused to resume-pending&lt;/b&gt;&lt;br&gt;admission sends resume control_seq 1, manifest null" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="a"><mxGeometry x="10" y="336" width="600" height="56" as="geometry"/></mxCell>
    <mxCell id="ae4" style="endArrow=block;html=1;" edge="1" parent="a" source="a3" target="a4"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="a5" value="&lt;b&gt;6. job.resumed, row resume-pending to running&lt;/b&gt;&lt;br&gt;before any task runs; resume_counter 1; sim pending with fresh budgets guest 1, infra 10, kept [c2, c1]" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="a"><mxGeometry x="10" y="410" width="600" height="56" as="geometry"/></mxCell>
    <mxCell id="ae5" style="endArrow=block;html=1;" edge="1" parent="a" source="a4" target="a5"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="a6" value="&lt;b&gt;7a. r1a3 starts from the head c2 and succeeds&lt;/b&gt;&lt;br&gt;commit attempt r1a3, row running to succeeded" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="a"><mxGeometry x="10" y="484" width="600" height="56" as="geometry"/></mxCell>
    <mxCell id="ae6" style="endArrow=block;html=1;" edge="1" parent="a" source="a5" target="a6"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="a7" value="&lt;b&gt;7b. instead of 7a, r1a3 reports CHECKPOINT_CORRUPT&lt;/b&gt;&lt;br&gt;no budget charged, head dropped: r1a4 starts from c1 and succeeds; with no checkpoint left it is ARTIFACT_LOST" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="a"><mxGeometry x="10" y="558" width="600" height="56" as="geometry"/></mxCell>
    <mxCell id="a8" value="&lt;b&gt;Moves of the row&lt;/b&gt;&lt;br&gt;admitted to running, running to paused, resume-pending to running, running to succeeded" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="a"><mxGeometry x="10" y="632" width="600" height="56" as="geometry"/></mxCell>
    <mxCell id="b" value="Patched resume: build then a checkpoint-capable sim, retries 0" style="swimlane;startSize=30;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="660" y="60" width="620" height="706" as="geometry"/></mxCell>
    <mxCell id="b0" value="&lt;b&gt;1. r0: build (source aaaa) succeeds, cache entry recorded&lt;/b&gt;&lt;br&gt;sim r0a1 fails timeout with c1, retries 0: sim paused" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="b"><mxGeometry x="10" y="40" width="600" height="56" as="geometry"/></mxCell>
    <mxCell id="b1" value="&lt;b&gt;2. job.paused, row running to paused&lt;/b&gt;&lt;br&gt;reason retries-exhausted" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="b"><mxGeometry x="10" y="114" width="600" height="56" as="geometry"/></mxCell>
    <mxCell id="be1" style="endArrow=block;html=1;" edge="1" parent="b" source="b0" target="b1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="b2" value="&lt;b&gt;3. resume control_seq 1 with a patched manifest (source broken)&lt;/b&gt;&lt;br&gt;job.resumed, resume-pending to running, resume_counter 1; load_plan, patch_check recompile [build]" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="b"><mxGeometry x="10" y="188" width="600" height="56" as="geometry"/></mxCell>
    <mxCell id="be2" style="endArrow=block;html=1;" edge="1" parent="b" source="b1" target="b2"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="b3" value="&lt;b&gt;4. build and sim pending, fresh budgets&lt;/b&gt;&lt;br&gt;build looks the new key up in the cache: miss, placed with that key" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="b"><mxGeometry x="10" y="262" width="600" height="56" as="geometry"/></mxCell>
    <mxCell id="be3" style="endArrow=block;html=1;" edge="1" parent="b" source="b2" target="b3"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="b4" value="&lt;b&gt;5. build r1a2 fails compile_failed (deterministic)&lt;/b&gt;&lt;br&gt;a compile after a resume pauses whatever its flag: build paused, sim blocked" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="b"><mxGeometry x="10" y="336" width="600" height="56" as="geometry"/></mxCell>
    <mxCell id="be4" style="endArrow=block;html=1;" edge="1" parent="b" source="b3" target="b4"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="b5" value="&lt;b&gt;6. job.paused, row running to paused&lt;/b&gt;&lt;br&gt;reason resume-compile-failed: the status table has no move from resume-pending to paused" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="b"><mxGeometry x="10" y="410" width="600" height="56" as="geometry"/></mxCell>
    <mxCell id="be5" style="endArrow=block;html=1;" edge="1" parent="b" source="b4" target="b5"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="b6" value="&lt;b&gt;7. resume control_seq 2 with a patched manifest (source fixed)&lt;/b&gt;&lt;br&gt;job.resumed, resume_counter 2; build r2a3 succeeds with a new component" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="b"><mxGeometry x="10" y="484" width="600" height="56" as="geometry"/></mxCell>
    <mxCell id="be6" style="endArrow=block;html=1;" edge="1" parent="b" source="b5" target="b6"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="b7" value="&lt;b&gt;8. sim r2a2 starts from c1 and reads the new component&lt;/b&gt;&lt;br&gt;row running to succeeded" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="b"><mxGeometry x="10" y="558" width="600" height="56" as="geometry"/></mxCell>
    <mxCell id="be7" style="endArrow=block;html=1;" edge="1" parent="b" source="b6" target="b7"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="b8" value="&lt;b&gt;A patch that does not load or that patch_check refuses&lt;/b&gt;&lt;br&gt;runs nothing: job.resumed, then job.paused for the reason the job had (test_refused_patch_stays_paused)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="b"><mxGeometry x="10" y="632" width="600" height="56" as="geometry"/></mxCell>
  </root>
</mxGraphModel>
