<mxGraphModel adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="t" value="Aggregate semantics: a worked example from wdf_workflow.aggregate, wdf_workflow.ready and wdf_workflow.result" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1260" height="30" as="geometry"/></mxCell>
    <mxCell id="a" value="allow_partial false: build, sim-a to sim-d, agg over the four results, after a job that recorded build" style="swimlane;startSize=30;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="620" height="484" as="geometry"/></mxCell>
    <mxCell id="a0" value="&lt;b&gt;1. build: compile cache hit&lt;/b&gt;&lt;br&gt;task.skipped compile-cache-hit, state skipped, which counts as succeeded for its dependents" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="a"><mxGeometry x="10" y="40" width="600" height="56" as="geometry"/></mxCell>
    <mxCell id="a1" value="&lt;b&gt;2. sim-d: guest_memory_cap&lt;/b&gt;&lt;br&gt;deterministic, budget none, no checkpoint flag: task.failed, state failed" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="a"><mxGeometry x="10" y="114" width="600" height="56" as="geometry"/></mxCell>
    <mxCell id="ae1" style="endArrow=block;html=1;" edge="1" parent="a" source="a0" target="a1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="a2" value="&lt;b&gt;3. settle: agg blocked at once&lt;/b&gt;&lt;br&gt;a dependency failed, so agg is blocked and never placed, task_attempt 0 in the status query" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="a"><mxGeometry x="10" y="188" width="600" height="56" as="geometry"/></mxCell>
    <mxCell id="ae2" style="endArrow=block;html=1;" edge="1" parent="a" source="a1" target="a2"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="a3" value="&lt;b&gt;4. sim-a still runs to its end&lt;/b&gt;&lt;br&gt;Zombie after 2 s: succeeded, committed. The other chains drain; nothing waits on agg" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="a"><mxGeometry x="10" y="262" width="600" height="56" as="geometry"/></mxCell>
    <mxCell id="ae3" style="endArrow=block;html=1;" edge="1" parent="a" source="a2" target="a3"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="a4" value="&lt;b&gt;5. outcome: nothing runs or is ready&lt;/b&gt;&lt;br&gt;no build_index call, no aggregate task taken on wdf-aggregate" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="a"><mxGeometry x="10" y="336" width="600" height="56" as="geometry"/></mxCell>
    <mxCell id="ae4" style="endArrow=block;html=1;" edge="1" parent="a" source="a3" target="a4"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="a5" value="&lt;b&gt;6. job.failed, row running to failed&lt;/b&gt;&lt;br&gt;reason retries-exhausted: sim-d; states agg blocked, build skipped, sim-a to sim-c succeeded, sim-d failed" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="a"><mxGeometry x="10" y="410" width="600" height="56" as="geometry"/></mxCell>
    <mxCell id="ae5" style="endArrow=block;html=1;" edge="1" parent="a" source="a4" target="a5"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="b" value="allow_partial true: plus build-x and sim-e, agg over sim-a to sim-e" style="swimlane;startSize=30;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="660" y="60" width="620" height="558" as="geometry"/></mxCell>
    <mxCell id="b0" value="&lt;b&gt;1. build-x: compile_failed&lt;/b&gt;&lt;br&gt;deterministic, task.failed; its own source, so its own cache key" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="b"><mxGeometry x="10" y="40" width="600" height="56" as="geometry"/></mxCell>
    <mxCell id="b1" value="&lt;b&gt;2. sim-d: guest_memory_cap&lt;/b&gt;&lt;br&gt;task.failed, state failed; sim-e is blocked behind build-x" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="b"><mxGeometry x="10" y="114" width="600" height="56" as="geometry"/></mxCell>
    <mxCell id="be1" style="endArrow=block;html=1;" edge="1" parent="b" source="b0" target="b1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="b2" value="&lt;b&gt;3. settle: agg pending, then ready&lt;/b&gt;&lt;br&gt;agg waits while any input is pending, ready or running, then runs because sim-a to sim-c are done" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="b"><mxGeometry x="10" y="188" width="600" height="56" as="geometry"/></mxCell>
    <mxCell id="be2" style="endArrow=block;html=1;" edge="1" parent="b" source="b1" target="b2"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="b3" value="&lt;b&gt;4. build_index on the control queue&lt;/b&gt;&lt;br&gt;partial true (header partial allow), entries in task id order: sim-a, sim-b, sim-c succeeded with their committed result references; sim-d failed; sim-e missing, no reference" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="b"><mxGeometry x="10" y="262" width="600" height="56" as="geometry"/></mxCell>
    <mxCell id="be3" style="endArrow=block;html=1;" edge="1" parent="b" source="b2" target="b3"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="b4" value="&lt;b&gt;5. run_task on wdf-aggregate&lt;/b&gt;&lt;br&gt;request.data.inputs is the one index reference returned by build_index, no result reference; params.index null" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="b"><mxGeometry x="10" y="336" width="600" height="56" as="geometry"/></mxCell>
    <mxCell id="be4" style="endArrow=block;html=1;" edge="1" parent="b" source="b3" target="b4"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="b5" value="&lt;b&gt;6. agg succeeded, commit summary and log tail&lt;/b&gt;&lt;br&gt;task.succeeded and task.result.ready for agg" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="b"><mxGeometry x="10" y="410" width="600" height="56" as="geometry"/></mxCell>
    <mxCell id="be5" style="endArrow=block;html=1;" edge="1" parent="b" source="b4" target="b5"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="b6" value="&lt;b&gt;7. job.partial, row running to partial&lt;/b&gt;&lt;br&gt;skipped_tasks [build-x, sim-d, sim-e]: every task neither succeeded nor skipped; sim-e stays blocked" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="b"><mxGeometry x="10" y="484" width="600" height="56" as="geometry"/></mxCell>
    <mxCell id="be6" style="endArrow=block;html=1;" edge="1" parent="b" source="b5" target="b6"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="c" value="&lt;b&gt;Aggregate-only job: agg with no dependencies and params.index set&lt;/b&gt;&lt;br&gt;no build_index call; inputs is the submitter&#x27;s index s3://wdf-sources/sha256/bb/bbb...b (kind index); the job succeeds" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="638" width="1260" height="56" as="geometry"/></mxCell>
  </root>
</mxGraphModel>
