    <mxCell id="c81" value="sim-b, sim-c" style="text;html=1;whiteSpace=wrap;align=left;" vertex="1" parent="c18"><mxGeometry x="570" y="310" width="220" height="32" as="geometry"/></mxCell>
    <mxCell id="c82" value="A task is ready only when every dependency is done, and blocked once one failed or paused. part runs over sim-a alone once its inputs settle. The job pauses only when nothing runs or is ready. A resume runs again every task that is not done, and part too, since it ran without sim-c." style="text;html=1;whiteSpace=wrap;align=left;fontStyle=2;" vertex="1" parent="c18"><mxGeometry x="10" y="350" width="780" height="60" as="geometry"/></mxCell>
    <mxCell id="c83" value="The other endings of the same run" style="swimlane;startSize=30;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="500" width="1120" height="150" as="geometry"/></mxCell>
    <mxCell id="c84" value="Manual pause while sim-a and sim-b run: to_interrupt gives sim-b (checkpoint), sim-a runs to completion, sim-c stays ready, and the job pauses with reason operator once nothing runs." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="c83"><mxGeometry x="10" y="40" width="350" height="90" as="geometry"/></mxCell>
    <mxCell id="c85" value="sim-b succeeds instead of exhausting: nothing is paused and part ran without sim-c, so the job ends partial with skipped_tasks agg, sim-c." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="c83"><mxGeometry x="380" y="40" width="350" height="90" as="geometry"/></mxCell>
    <mxCell id="c86" value="sim-b succeeds and part has no allow_partial: part is blocked by sim-c like agg, and the job ends failed with reason retries-exhausted: sim-c. A compile exhausting after a resume pauses with resume-compile-failed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="c83"><mxGeometry x="750" y="40" width="360" height="90" as="geometry"/></mxCell>
