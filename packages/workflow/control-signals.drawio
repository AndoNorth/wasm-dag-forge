<mxGraphModel adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="t" value="Control signals: a worked example from wdf_workflow.job and wdf_workflow.taskpath, with the values of test_control.py" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1260" height="30" as="geometry"/></mxCell>
    <mxCell id="a" value="Signal order: one checkpoint-capable sim, the signals of test_signal_dedup" style="swimlane;startSize=30;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="620" height="484" as="geometry"/></mxCell>
    <mxCell id="a0" value="&lt;b&gt;1. resume control_seq 5 while running&lt;/b&gt;&lt;br&gt;above 0, applied: control_seq 5, the job keeps running" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="a"><mxGeometry x="10" y="40" width="600" height="56" as="geometry"/></mxCell>
    <mxCell id="a1" value="&lt;b&gt;2. pause control_seq 4&lt;/b&gt;&lt;br&gt;not above 5: ignored, status query still running with control_seq 5" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="a"><mxGeometry x="10" y="114" width="600" height="56" as="geometry"/></mxCell>
    <mxCell id="ae1" style="endArrow=block;html=1;" edge="1" parent="a" source="a0" target="a1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="a2" value="&lt;b&gt;3. pause control_seq 6&lt;/b&gt;&lt;br&gt;applied: stop pause, sim cancelled, operator_interrupt, job.paused" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="a"><mxGeometry x="10" y="188" width="600" height="56" as="geometry"/></mxCell>
    <mxCell id="ae2" style="endArrow=block;html=1;" edge="1" parent="a" source="a1" target="a2"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="a3" value="&lt;b&gt;4. pause control_seq 6 again&lt;/b&gt;&lt;br&gt;not above 6: ignored, one job.paused in the history" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="a"><mxGeometry x="10" y="262" width="600" height="56" as="geometry"/></mxCell>
    <mxCell id="ae3" style="endArrow=block;html=1;" edge="1" parent="a" source="a2" target="a3"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="a4" value="&lt;b&gt;5. cancel 7, cancel 7&lt;/b&gt;&lt;br&gt;applied whenever it arrives, a repeat is a no-op: paused to cancelled, one job.cancelled" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="a"><mxGeometry x="10" y="336" width="600" height="56" as="geometry"/></mxCell>
    <mxCell id="ae4" style="endArrow=block;html=1;" edge="1" parent="a" source="a3" target="a4"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="a5" value="&lt;b&gt;Rank of the request in force&lt;/b&gt;&lt;br&gt;terminate over cancel over pause; a cancel also takes its sequence, so a resume carrying it is ignored" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="a"><mxGeometry x="10" y="410" width="600" height="56" as="geometry"/></mxCell>
    <mxCell id="ae5" style="endArrow=block;html=1;" edge="1" parent="a" source="a4" target="a5"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="b" value="Manual pause: build, sim-a (checkpoint) and sim-b, agg over sim-b" style="swimlane;startSize=30;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="660" y="60" width="620" height="484" as="geometry"/></mxCell>
    <mxCell id="b0" value="&lt;b&gt;1. pause control_seq 1 with sim-a and sim-b in flight&lt;/b&gt;&lt;br&gt;no new task or attempt is placed from here on" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="b"><mxGeometry x="10" y="40" width="600" height="56" as="geometry"/></mxCell>
    <mxCell id="b1" value="&lt;b&gt;2. sim-a: its run_task is cancelled&lt;/b&gt;&lt;br&gt;WAIT_CANCELLATION_COMPLETED: the worker takes a final checkpoint and fails operator_interrupt" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="b"><mxGeometry x="10" y="114" width="600" height="56" as="geometry"/></mxCell>
    <mxCell id="be1" style="endArrow=block;html=1;" edge="1" parent="b" source="b0" target="b1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="b2" value="&lt;b&gt;3. sim-a: budget free, state paused&lt;/b&gt;&lt;br&gt;checkpoint indexed, task.checkpoint.committed, head of the kept list, guest 1, infra 10" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="b"><mxGeometry x="10" y="188" width="600" height="56" as="geometry"/></mxCell>
    <mxCell id="be2" style="endArrow=block;html=1;" edge="1" parent="b" source="b1" target="b2"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="b3" value="&lt;b&gt;4. sim-b runs to completion after 3 s&lt;/b&gt;&lt;br&gt;not checkpoint-capable: succeeded, committed" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="b"><mxGeometry x="10" y="262" width="600" height="56" as="geometry"/></mxCell>
    <mxCell id="be3" style="endArrow=block;html=1;" edge="1" parent="b" source="b2" target="b3"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="b4" value="&lt;b&gt;5. agg ready, task_attempt 0&lt;/b&gt;&lt;br&gt;its input is done, but a pause places nothing" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="b"><mxGeometry x="10" y="336" width="600" height="56" as="geometry"/></mxCell>
    <mxCell id="be4" style="endArrow=block;html=1;" edge="1" parent="b" source="b3" target="b4"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="b5" value="&lt;b&gt;6. nothing runs: job.paused, reason operator&lt;/b&gt;&lt;br&gt;row running to paused, the job waits on a condition with no timer" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="b"><mxGeometry x="10" y="410" width="600" height="56" as="geometry"/></mxCell>
    <mxCell id="be5" style="endArrow=block;html=1;" edge="1" parent="b" source="b4" target="b5"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="c" value="Cancel and terminate over tasks in flight" style="swimlane;startSize=30;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="560" width="620" height="336" as="geometry"/></mxCell>
    <mxCell id="c0" value="&lt;b&gt;cancel: every task path is cancelled&lt;/b&gt;&lt;br&gt;asyncio cancel of each path, which asks each run_task to cancel" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="c"><mxGeometry x="10" y="40" width="600" height="56" as="geometry"/></mxCell>
    <mxCell id="c1" value="&lt;b&gt;each activity answers the cancel&lt;/b&gt;&lt;br&gt;Hang ends cancelled: ActivityTaskCancelRequested then ActivityTaskCanceled, twice" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="c"><mxGeometry x="10" y="114" width="600" height="56" as="geometry"/></mxCell>
    <mxCell id="ce1" style="endArrow=block;html=1;" edge="1" parent="c" source="c0" target="c1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="c2" value="&lt;b&gt;then job.cancelled&lt;/b&gt;&lt;br&gt;sim-a and sim-b cancelled, agg blocked behind them; a workflow cancel request does the same and re-raises" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="c"><mxGeometry x="10" y="188" width="600" height="56" as="geometry"/></mxCell>
    <mxCell id="ce2" style="endArrow=block;html=1;" edge="1" parent="c" source="c1" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="c3" value="&lt;b&gt;terminate: hard stop&lt;/b&gt;&lt;br&gt;the run_task of a Die worker is asked to cancel, and job.terminated is written in under 15 s, not after the 60 s heartbeat timeout" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="c"><mxGeometry x="10" y="262" width="600" height="56" as="geometry"/></mxCell>
    <mxCell id="d" value="A pause that finds a task not started, and the Lost answers of a move" style="swimlane;startSize=30;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="660" y="560" width="620" height="410" as="geometry"/></mxCell>
    <mxCell id="d0" value="&lt;b&gt;queued checkpoint-capable task&lt;/b&gt;&lt;br&gt;the cancel resolves at once as cancelled: no failure, ready, task_attempt 0" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="d"><mxGeometry x="10" y="40" width="600" height="56" as="geometry"/></mxCell>
    <mxCell id="d1" value="&lt;b&gt;queued task, schedule-to-start 5 s&lt;/b&gt;&lt;br&gt;the timeout is no failure: no re-place, ready, task_attempt 0" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="d"><mxGeometry x="10" y="114" width="600" height="56" as="geometry"/></mxCell>
    <mxCell id="d2" value="&lt;b&gt;Lost resume-pending on paused to cancelled&lt;/b&gt;&lt;br&gt;tried once more from resume-pending, not counted as lost" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="d"><mxGeometry x="10" y="188" width="600" height="56" as="geometry"/></mxCell>
    <mxCell id="d3" value="&lt;b&gt;Lost cancelled on running to succeeded&lt;/b&gt;&lt;br&gt;the job ended outside the workflow: nothing more is written, the workflow returns cancelled" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="d"><mxGeometry x="10" y="262" width="600" height="56" as="geometry"/></mxCell>
    <mxCell id="d4" value="&lt;b&gt;Lost accepted on admitted to running&lt;/b&gt;&lt;br&gt;counted, nothing placed, sent again at 1 s, 2 s, 4 s until the row agrees" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="d"><mxGeometry x="10" y="336" width="600" height="56" as="geometry"/></mxCell>
  </root>
</mxGraphModel>
