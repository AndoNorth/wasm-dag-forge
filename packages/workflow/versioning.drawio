    <mxCell id="t" value="wdf_workflow.versioning: a rollout from exit-a to exit-b, worked example from test_drain_detects_no_pinned and test_override_procedure" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1240" height="30" as="geometry"/></mxCell>
    <mxCell id="la" value="Deployment workflow-worker-exit-a&lt;br&gt;version wdf-workflow-worker / exit-a" style="swimlane;startSize=44;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="300" height="680" as="geometry"/></mxCell>
    <mxCell id="lv" value="wdf_workflow.versioning, run by the rollout" style="swimlane;startSize=44;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="340" y="60" width="520" height="680" as="geometry"/></mxCell>
    <mxCell id="lb" value="Deployment workflow-worker-exit-b&lt;br&gt;version wdf-workflow-worker / exit-b" style="swimlane;startSize=44;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="880" y="60" width="300" height="680" as="geometry"/></mxCell>
    <mxCell id="a1" value="exit-a polls wdf-workflow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="la"><mxGeometry x="20" y="60" width="260" height="40" as="geometry"/></mxCell>
    <mxCell id="v1" value="&lt;b&gt;1. set_current(exit-a)&lt;/b&gt;&lt;br&gt;pollers seen, current none, raw call with the conflict token, returns none" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="lv"><mxGeometry x="20" y="60" width="480" height="50" as="geometry"/></mxCell>
    <mxCell id="a2" value="&lt;b&gt;paused job&lt;/b&gt;: sim fails guest_memory_cap, checkpointed, so the job pauses&lt;br&gt;&lt;b&gt;open job&lt;/b&gt;: waits on wdf-simulate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="la"><mxGeometry x="20" y="125" width="260" height="80" as="geometry"/></mxCell>
    <mxCell id="b1" value="exit-b polls wdf-workflow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="lb"><mxGeometry x="20" y="220" width="260" height="40" as="geometry"/></mxCell>
    <mxCell id="v2" value="&lt;b&gt;2. set_current(exit-b)&lt;/b&gt;&lt;br&gt;waits for exit-b's pollers, never allow_no_pollers, returns exit-a" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="lv"><mxGeometry x="20" y="215" width="480" height="50" as="geometry"/></mxCell>
    <mxCell id="v3" value="&lt;b&gt;3. drainage(exit-a)&lt;/b&gt;: pinned 2, drained false&lt;br&gt;retire(exit-a) raises NotDrained, nothing deleted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="lv"><mxGeometry x="20" y="290" width="480" height="50" as="geometry"/></mxCell>
    <mxCell id="v4" value="&lt;b&gt;4. move(paused job, exit-b, wait 2 s)&lt;/b&gt;&lt;br&gt;PinnedVersioningOverride, mask versioning_override, read back by describe; no task in 2 s, so state overridden&lt;br&gt;drainage(exit-a): pinned 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="lv"><mxGeometry x="20" y="360" width="480" height="80" as="geometry"/></mxCell>
    <mxCell id="b2" value="paused job pinned here, runs on exit-b at its next task" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="lb"><mxGeometry x="20" y="375" width="260" height="50" as="geometry"/></mxCell>
    <mxCell id="a3" value="open job finishes: succeeded, every workflow task on exit-a" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="la"><mxGeometry x="20" y="460" width="260" height="50" as="geometry"/></mxCell>
    <mxCell id="v5" value="&lt;b&gt;5. drainage(exit-a)&lt;/b&gt;: pinned 0, drained true, in under 5 s&lt;br&gt;the server's own status reported beside it, not waited on" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="lv"><mxGeometry x="20" y="460" width="480" height="50" as="geometry"/></mxCell>
    <mxCell id="v6" value="&lt;b&gt;6. retire(exit-a)&lt;/b&gt;: kubectl delete deployment workflow-worker-exit-a&lt;br&gt;retire(exit-b) refused: it is current" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="lv"><mxGeometry x="20" y="535" width="480" height="50" as="geometry"/></mxCell>
    <mxCell id="a4" value="deleted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#666666;" vertex="1" parent="la"><mxGeometry x="20" y="540" width="260" height="40" as="geometry"/></mxCell>
    <mxCell id="b3" value="current, pinned 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="lb"><mxGeometry x="20" y="540" width="260" height="40" as="geometry"/></mxCell>
    <mxCell id="q" value="count: TemporalWorkerDeploymentVersion = 'wdf-workflow-worker:exit-a' AND TemporalWorkflowVersioningBehavior = 'Pinned' AND ExecutionStatus = 'Running'" style="text;html=1;whiteSpace=wrap;align=left;fontSize=11;fontColor=#666666;" vertex="1" parent="lv"><mxGeometry x="20" y="620" width="480" height="40" as="geometry"/></mxCell>
    <mxCell id="o" value="Override procedure, test_override_procedure" style="swimlane;startSize=30;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="760" width="1160" height="150" as="geometry"/></mxCell>
    <mxCell id="o1" value="&lt;b&gt;fixed job&lt;/b&gt; on exit-a, move to exit-b (same code, replays the history)&lt;br&gt;overridden, then its next task completes on exit-b: &lt;b&gt;moved&lt;/b&gt;, succeeded" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="o"><mxGeometry x="20" y="45" width="540" height="90" as="geometry"/></mxCell>
    <mxCell id="o2" value="&lt;b&gt;broken job&lt;/b&gt; on exit-a, move to exit-c (an unguarded timer before the first activity)&lt;br&gt;its next task fails with NON_DETERMINISTIC_ERROR, the job is pinned back to exit-a: &lt;b&gt;reverted&lt;/b&gt;, succeeded on exit-a" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="o"><mxGeometry x="600" y="45" width="540" height="90" as="geometry"/></mxCell>
