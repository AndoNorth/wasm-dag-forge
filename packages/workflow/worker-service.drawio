    <mxCell id="x3" value="3. SIGTERM: polls stop, commit finishes and reports its result before the service returns" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="ex"><mxGeometry x="480" y="45" width="240" height="80" as="geometry"/></mxCell>
