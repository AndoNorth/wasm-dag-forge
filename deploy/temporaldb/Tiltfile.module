# Temporal's Postgres: plain Postgres on the infra pool with the two databases the Temporal server expects.
# The databases are created by the image's init hook on the first start of an empty volume, and the schema is the
# server's own.
module = read_yaml("module.yaml")
pin = read_yaml("../versions.yaml")["images"][module["artifact"]["pin"]]
name = module["name"]
namespace = module["namespace"]
res = module["resources"][name]
labels = {"app": name}
topology = read_yaml("../../contracts/topology/topology.yaml")
pool = {"key": topology["pool_label"], "value": "infra"}
databases = ["temporal", "temporal_visibility"]
data = "/var/lib/postgresql/data"

# The password is generated once into the state directory and delivered as a Secret.
watch_file("../../scripts/storage/db/secret.sh")
k8s_yaml(local(["../../scripts/storage/db/secret.sh", name, namespace], quiet = True))

k8s_yaml(encode_yaml({
    "apiVersion": "v1",
    "kind": "ConfigMap",
    "metadata": {"name": name + "-init", "namespace": namespace},
    "data": {"databases.sh": "\n".join(
        ["#!/bin/sh", "set -eu"] +
        ['psql -v ON_ERROR_STOP=1 -U "$POSTGRES_USER" -c "CREATE DATABASE %s"' % d for d in databases]
    ) + "\n"},
}))

k8s_yaml(encode_yaml({
    "apiVersion": "apps/v1",
    "kind": "StatefulSet",
    "metadata": {"name": name, "namespace": namespace},
    "spec": {
        "serviceName": name,
        "replicas": 1,
        "selector": {"matchLabels": labels},
        "template": {
            "metadata": {"labels": labels},
            "spec": {
                "nodeSelector": {pool["key"]: pool["value"]},
                "tolerations": [{
                    "key": pool["key"],
                    "operator": "Equal",
                    "value": pool["value"],
                    "effect": topology["taint_effect"],
                }],
                "containers": [{
                    "name": name,
                    "image": "docker.io/library/postgres@" + pin["digest"],
                    "ports": [{"containerPort": 5432}],
                    "env": [
                        {"name": "POSTGRES_PASSWORD", "valueFrom": {"secretKeyRef": {"name": name, "key": "POSTGRES_PASSWORD"}}},
                        # A subdirectory keeps the volume's own lost+found out of the data directory.
                        {"name": "PGDATA", "value": data + "/pgdata"},
                    ],
                    "readinessProbe": {
                        "exec": {"command": ["pg_isready", "-U", "postgres"]},
                        "periodSeconds": 5,
                    },
                    "resources": res,
                    "volumeMounts": [
                        {"name": "data", "mountPath": data},
                        {"name": "init", "mountPath": "/docker-entrypoint-initdb.d", "readOnly": True},
                    ],
                }],
                "volumes": [{"name": "init", "configMap": {"name": name + "-init", "defaultMode": 365}}],
            },
        },
        "volumeClaimTemplates": [{
            "metadata": {"name": "data"},
            "spec": {
                "accessModes": ["ReadWriteOnce"],
                "resources": {"requests": {"storage": "5Gi"}},
            },
        }],
    },
}))

k8s_yaml(encode_yaml({
    "apiVersion": "v1",
    "kind": "Service",
    "metadata": {"name": name, "namespace": namespace},
    "spec": {"clusterIP": "None", "selector": labels, "ports": [{"port": 5432, "targetPort": 5432}]},
}))

k8s_resource(
    name,
    objects = [name + ":secret:" + namespace, name + "-init:configmap:" + namespace],
    labels = [module["group"]],
    resource_deps = [d.split("/")[1] for d in module.get("depends_on", [])],
)
